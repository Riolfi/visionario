---
import '../styles/global.css';
import ThemeVars from '../components/ThemeVars.astro';
import { can, visibleScreens } from '../lib/rbac';
import { unreadNotificationCount } from '../lib/repo/notifications';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const brandName = Astro.locals.brand.name;
const logoUrl = Astro.locals.site.brand.data.logo_url;

// só as telas que essa pessoa pode abrir; Permissões e Cargos são só do Administrador
const access = Astro.locals.admin;
const nav: { href: string; label: string }[] = access
  ? visibleScreens(access)
      .filter((s) => s.key !== 'notificacoes') // fica no sino do cabeçalho
      .map(({ href, label }) => ({ href, label }))
  : [];
if (access?.isOwner) nav.push({ href: '/admin/permissoes', label: 'Permissões' }, { href: '/admin/cargos', label: 'Cargos' });
const showBell = can(access, 'notificacoes.ver');

const unread = showBell ? await unreadNotificationCount() : 0;

const isActive = (href: string) =>
  path === href || (href !== '/admin' && path.startsWith(href));

---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ThemeVars />
    <!-- modo escuro: aplica antes de pintar (escolha guardada; sem escolha, segue o aparelho) -->
    <script is:inline>
      try {
        const t = localStorage.getItem('admin-tema');
        if (t === 'escuro' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('admin-dark');
      } catch (e) {}
    </script>
    <title>{title} · Área Administrativa {brandName}</title>
  </head>
  <body class="bg-bone-50">
    <div id="admin-shell" class="group flex min-h-screen">
      <!-- menu recolhido no desktop (escolha guardada): aplica antes de pintar -->
      <script is:inline>
        try {
          if (localStorage.getItem('admin-menu') === 'fechado') document.getElementById('admin-shell').classList.add('is-collapsed');
        } catch (e) {}
      </script>
      <!-- Celular: o menu lateral vira gaveta (abre no ☰); a partir de sm fica fixo -->
      <div data-admin-close class="fixed inset-0 z-30 hidden bg-ink/40 group-[.is-open]:block sm:!hidden" aria-hidden="true"></div>
      <aside
        id="admin-sidebar"
        class="fixed inset-y-0 left-0 z-40 flex w-64 shrink-0 -translate-x-full flex-col overflow-y-auto border-r border-ink/10 bg-bone px-4 py-6 transition-transform duration-200 group-[.is-open]:translate-x-0 sm:sticky sm:top-0 sm:z-auto sm:h-screen sm:w-56 sm:translate-x-0 sm:transition-none sm:group-[.is-collapsed]:hidden"
      >
        <div class="flex items-start justify-between">
          <div class="px-2">
            {logoUrl ? (
              <img src={logoUrl} alt={brandName} class="admin-logo h-10 w-auto max-w-[180px] object-contain" />
            ) : (
              <p class="font-display text-xl lowercase">{brandName}</p>
            )}
            <p class="mt-1.5 font-sans text-[11px] uppercase tracking-[0.14em] text-ink-muted">Área Administrativa</p>
          </div>
          <button type="button" data-admin-close class="rounded-card px-2 py-1 text-xl leading-none text-ink-muted sm:hidden" aria-label="Fechar menu">✕</button>
        </div>
        <nav class="mt-8 flex flex-col gap-1" aria-label="Menu da área administrativa">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-card px-3 py-2 font-sans text-sm transition-colors',
                isActive(item.href) ? 'bg-ink text-bone' : 'text-ink-soft hover:bg-bone-200',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <a
          href="/admin/perfil"
          aria-current={isActive('/admin/perfil') ? 'page' : undefined}
          class:list={[
            'mt-auto rounded-card px-3 py-2 font-sans text-sm transition-colors',
            isActive('/admin/perfil') ? 'bg-ink text-bone' : 'text-ink-soft hover:bg-bone-200',
          ]}
        >
          Meu perfil
        </a>
        <form method="POST" action="/auth/sair" class="pt-1">
          <button class="w-full rounded-card px-3 py-2 text-left font-sans text-sm text-ink-muted hover:bg-bone-200">
            Sair
          </button>
        </form>
      </aside>

      <div class="min-w-0 flex-1">
        <!-- fixo no topo: o ☰ fica sempre ao alcance, mesmo rolando a página -->
        <header class="sticky top-0 z-20 flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 bg-bone px-4 py-4 sm:px-6">
          <div class="flex items-center gap-3">
            <button
              type="button"
              data-admin-toggle
              class="-ml-1 rounded-card p-1.5 text-ink hover:bg-bone-200"
              aria-controls="admin-sidebar"
              aria-expanded="false"
              aria-label="Abrir ou fechar o menu"
              title="Abrir/fechar menu (Ctrl+B)"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
            <h1 class="font-display text-2xl">{title}</h1>
          </div>
          <div class="flex items-center gap-1">
          <button
            type="button"
            data-theme-toggle
            class="rounded-card p-1.5 text-ink hover:bg-bone-200"
            aria-label="Alternar modo claro/escuro"
            title="Modo claro/escuro"
          >
            <!-- lua no claro (vai para escuro), sol no escuro (vai para claro) -->
            <svg class="admin-dark-hide" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="admin-dark-show" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          {showBell && (<a
            href="/admin/notificacoes"
            class="relative rounded-card p-1.5 text-ink hover:bg-bone-200"
            aria-label={unread ? `Notificações: ${unread} não lida${unread > 1 ? 's' : ''}` : 'Notificações'}
            title="Notificações"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
            {unread > 0 && (
              <span class="absolute -bottom-0.5 -left-0.5 grid h-[18px] min-w-[18px] place-items-center rounded-full bg-red-600 px-1 font-sans text-[10px] font-bold leading-none text-white ring-2 ring-bone">
                {unread > 99 ? '99+' : unread}
              </span>
            )}
          </a>)}
          </div>
        </header>
        <main class="p-4 sm:p-6">
          <slot />
        </main>
      </div>
    </div>
    <!-- carregando: aparece quando a tela começa a sair, some com a tela nova -->
    <div id="page-loader" role="status" aria-live="polite">
      <div class="bar"></div>
      <div class="card"><div class="spin"></div></div>
      <span class="sr-only">Carregando…</span>
    </div>
    <script>
      // ---- modo escuro ----
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('admin-dark');
        try {
          localStorage.setItem('admin-tema', dark ? 'escuro' : 'claro');
        } catch {}
      });

      // ---- carregando ----
      const loader = document.getElementById('page-loader')!;
      window.addEventListener('beforeunload', () => loader.classList.add('is-loading'));
      // voltar/avançar com a página em cache: esconde de novo
      window.addEventListener('pageshow', () => loader.classList.remove('is-loading'));

      const shell = document.getElementById('admin-shell')!;
      const toggle = document.querySelector<HTMLButtonElement>('[data-admin-toggle]')!;
      const desktop = window.matchMedia('(min-width: 640px)');
      const setOpen = (open: boolean) => {
        shell.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      };
      // desktop: recolhe/abre o menu fixo e guarda a escolha; celular: gaveta
      const toggleMenu = () => {
        if (!desktop.matches) return setOpen(!shell.classList.contains('is-open'));
        const collapsed = shell.classList.toggle('is-collapsed');
        toggle.setAttribute('aria-expanded', String(!collapsed));
        try {
          localStorage.setItem('admin-menu', collapsed ? 'fechado' : 'aberto');
        } catch {}
      };
      if (desktop.matches) toggle.setAttribute('aria-expanded', String(!shell.classList.contains('is-collapsed')));
      toggle.addEventListener('click', toggleMenu);
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
          e.preventDefault();
          toggleMenu();
        }
      });
      document.querySelectorAll('[data-admin-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
    </script>
  </body>
</html>
