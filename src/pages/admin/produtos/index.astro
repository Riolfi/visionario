---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getProducts } from '../../../lib/repo/catalog';
import { brl } from '../../../lib/format';
import CameraScanButton, { SCAN_BTN, CHECK_ICON_PATH } from '../../../components/CameraScanButton';

export const prerender = false;

const products = await getProducts({ includeInactive: true, sort: 'novidades' });
import { can } from '../../../lib/rbac';
const canEdit = can(Astro.locals.admin, 'produtos.editar');
---

<AdminLayout title="Produtos">
  <div class="flex items-center justify-between">
    <p id="product-count" class="font-sans text-sm text-ink-muted" data-total={products.length}>{products.length} produtos no catálogo</p>
    {canEdit && <a href="/admin/produtos/novo" class="btn-primary">Novo produto</a>}
  </div>

  <div class="mt-4 rounded-card border border-ink/10 bg-white p-4">
    <h2 class="mb-3 font-display text-lg">Pesquisar produto</h2>
    <label class="label" for="name-search">Nome</label>
    <span class="relative mb-4 block">
      <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input id="name-search" class="field pl-11" type="search" placeholder="Pesquise pelo nome do produto…" autocomplete="off" />
    </span>
    <label class="label" for="barcode-scan">Código de barras</label>
    <div class="flex items-stretch gap-2">
      <input
        id="barcode-scan"
        class="field min-w-0 flex-1"
        inputmode="numeric"
        placeholder="digitar código de barras manualmente"
        autocomplete="off"
      />
      <button type="button" id="barcode-send" class={SCAN_BTN}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={CHECK_ICON_PATH} /></svg>
        Enviar
      </button>
    </div>
    <div class="mt-2 flex justify-end"><CameraScanButton client:load targetId="barcode-scan" /></div>
    <p id="barcode-scan-status" class="mt-1 font-sans text-[13px] text-ink-muted empty:hidden" aria-live="polite"></p>
  </div>

  <!-- table-fixed + nome truncado: cabe na tela sem rolagem lateral -->
  <div class="mt-6 rounded-card border border-ink/10 bg-white">
    <table class="w-full table-fixed text-left text-sm">
      <thead class="border-b border-ink/10 text-[11px] uppercase tracking-[0.1em] text-ink-muted">
        <tr>
          <th class="w-14 py-3 pl-2 sm:w-16 sm:pl-3">Prévia</th>
          <th class="px-2 py-3 sm:px-3">Produto</th>
          <th class="hidden w-20 px-3 py-3 text-right sm:table-cell">Estoque</th>
          <th class="w-[4.5rem] px-1 py-3 sm:w-24 sm:px-3">Status</th>
          <th class="w-[4.5rem] px-2 py-3 sm:w-24 sm:px-3"><span class="sr-only">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        {products.map((p) => (
          <tr class="product-row border-t border-ink/10 hover:bg-bone-50" data-name={p.name} data-barcode={p.barcode ?? ''}>
            <td class="py-2 pl-2 sm:pl-3">
              <span class="block h-10 w-10 overflow-hidden rounded-card bg-bone-200 sm:h-11 sm:w-11">
                {p.images[0] && <img src={p.images[0]} alt="" loading="lazy" class="h-full w-full object-cover" />}
              </span>
            </td>
            <td class="px-2 py-3 sm:px-3">
              <a href={`/admin/produtos/${p.id}`} class="block truncate font-medium text-agua-dark" title={p.name}>{p.name}</a>
              <span class="block truncate text-[12px] text-ink-muted">{brl(p.price_cents)}<span class="hidden sm:inline"> · {p.category_name}</span></span>
            </td>
            <td class:list={['hidden px-3 py-3 text-right sm:table-cell', p.stock <= 5 && 'text-red-700']}>{p.stock}</td>
            <td class="px-1 py-3 sm:px-3">
              <span class:list={['rounded-full px-2 py-0.5 text-[10px] uppercase sm:text-[11px]', p.is_active ? 'bg-agua-wash text-agua-dark' : 'bg-bone-200 text-ink-muted']}>
                {p.is_active ? 'ativo' : 'inativo'}
              </span>
            </td>
            <td class="px-2 py-3 sm:px-3">
              <div class="flex justify-end">
                <a href={`/admin/produtos/${p.id}`} class="rounded-card border border-ink/20 px-2 py-1 text-[12px] hover:bg-bone-100 sm:px-3 sm:text-[13px]">{canEdit ? 'Editar' : 'Ver'}</a>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p id="no-results" class="hidden p-4 text-sm text-ink-muted">Nenhum produto encontrado. Para cadastrar, digite ou leia o código de barras e toque em Enviar.</p>
  </div>
</AdminLayout>

<script>
  // Filtro da lista enquanto digita: nome (todas as palavras, sem acento e
  // sem diferenciar maiúscula) e código de barras (contém os dígitos).
  const fold = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const nameInput = document.getElementById('name-search') as HTMLInputElement;
  const codeInput = document.getElementById('barcode-scan') as HTMLInputElement;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('tr.product-row'));
  const count = document.getElementById('product-count')!;
  function filter() {
    const words = fold(nameInput.value).split(/\s+/).filter(Boolean);
    const digits = codeInput.value.replace(/\D/g, '');
    let shown = 0;
    for (const row of rows) {
      const name = fold(row.dataset.name ?? '');
      const ok = words.every((w) => name.includes(w)) && (!digits || (row.dataset.barcode ?? '').includes(digits));
      row.hidden = !ok;
      if (ok) shown++;
    }
    const total = Number(count.dataset.total);
    count.textContent = shown === total ? `${total} produtos no catálogo` : `${shown} de ${total} produtos`;
    document.getElementById('no-results')!.classList.toggle('hidden', shown > 0);
  }
  nameInput.addEventListener('input', filter);
  codeInput.addEventListener('input', filter);

  const input = document.getElementById('barcode-scan') as HTMLInputElement | null;
  const status = document.getElementById('barcode-scan-status');

  // Enter (leitor USB / teclado) e o botão "Enviar" fazem a mesma busca
  input?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    search();
  });
  document.getElementById('barcode-send')?.addEventListener('click', () => search());

  async function search() {
    if (!input) return;
    const code = input.value.trim();
    if (!code) return input.focus();

    input.disabled = true;
    if (status) status.textContent = 'Buscando…';
    try {
      const res = await fetch(`/api/admin/products/by-barcode?code=${encodeURIComponent(code)}`);
      if (res.ok) {
        const data = (await res.json()) as { id: string };
        window.location.href = `/admin/produtos/${data.id}`;
        return;
      }
      if (res.status === 404) {
        window.location.href = `/admin/produtos/novo?barcode=${encodeURIComponent(code)}`;
        return;
      }
      if (status) status.textContent = 'Erro ao buscar — tenta de novo.';
    } catch {
      if (status) status.textContent = 'Erro de conexão.';
    } finally {
      input.disabled = false;
    }
  }
</script>
