---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.tsx';
import SEO from '../components/SEO.astro';
import ThemeVars from '../components/ThemeVars.astro';
import { env } from '../lib/env';
import { theme } from '../lib/theme';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'product';
  bare?: boolean;
}

const { title, description, image, noindex, type, bare = false } = Astro.props;
const wpp = `https://wa.me/${Astro.locals.site?.contact.data.whatsapp_number || env.whatsappNumber}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={theme.themeColor ?? '#F6F3EE'} />
    <meta name="generator" content={Astro.generator} />
    <ThemeVars />
    <SEO title={title} description={description} image={image} noindex={noindex} type={type} />
    <slot name="head" />
  </head>
  <body>
    {!bare && <Header />}
    <main id="conteudo">
      <slot />
    </main>
    {!bare && <Footer />}

    {!bare && <CartDrawer client:only="preact" />}

    {!bare && (
      <a
        href={wpp}
        target="_blank"
        rel="noopener"
        class="fixed bottom-5 right-5 z-40 inline-flex h-12 w-12 items-center justify-center rounded-full bg-agua-dark text-white shadow-lg transition-transform hover:scale-105"
        aria-label="Falar no WhatsApp"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.9 9.9 0 0 0 4.84 1.24h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.94 1.34-.5.05-1.13.26-3.8-.8-3.2-1.26-5.24-4.5-5.4-4.7-.16-.2-1.3-1.72-1.3-3.28s.82-2.32 1.1-2.64c.28-.32.62-.4.82-.4h.6c.2 0 .46-.04.72.55.26.6.9 2.16.98 2.32.08.16.13.34.02.55-.1.2-.16.34-.32.52-.16.2-.34.44-.48.58-.16.16-.33.34-.14.66.18.32.82 1.36 1.76 2.2 1.22 1.08 2.24 1.42 2.56 1.58.32.16.5.14.68-.08.18-.2.78-.9.99-1.22.2-.32.42-.26.7-.16.28.1 1.8.86 2.12 1.02.32.16.52.24.6.36.08.14.08.78-.16 1.46Z"/>
        </svg>
      </a>
    )}

    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        function revealAll() {
          els.forEach(function (el) { el.classList.add('is-visible'); });
        }
        try {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduce || !('IntersectionObserver' in window)) {
            revealAll();
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px' },
          );
          els.forEach(function (el) { io.observe(el); });
          // failsafe: se algo travar, garante o conteúdo visível
          setTimeout(revealAll, 3000);
        } catch (e) {
          revealAll();
        }
      })();
    </script>
    <!-- aviso de login feito (?entrou=1, posto pelo /api/auth/login) -->
    <div id="login-toast" role="status" aria-live="polite" hidden
      class="fixed bottom-5 left-1/2 z-[60] -translate-x-1/2 whitespace-nowrap rounded-full bg-ink px-5 py-3 font-sans text-sm text-bone shadow-lg">
      Pronto, você entrou na sua conta.
    </div>
    <script>
      const url = new URL(location.href);
      if (url.searchParams.has('entrou')) {
        url.searchParams.delete('entrou');
        history.replaceState(null, '', url.pathname + url.search + url.hash);
        const t = document.getElementById('login-toast');
        if (t) {
          t.hidden = false;
          setTimeout(() => (t.hidden = true), 4000);
        }
      }
    </script>
      <script>
      // olho de mostrar/ocultar senha em todo campo PasswordInput
      import { enablePasswordToggles } from '../lib/form-helpers';
      enablePasswordToggles();
    </script>
  </body>
</html>
