---
import { orderLabel } from '../../../lib/format';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getOrderByNumber } from '../../../lib/repo/orders';
import { brl, formatCpf, formatPhone, orderStatusBadge, whatsappUrl } from '../../../lib/format';
import { FINAL_STATUSES, ORDER_NEXT, ORDER_STATUS_LABELS, orderStatusLabel, PAYMENT_METHOD_LABELS, RECEIVED_STATUSES, type OrderStatus } from '../../../lib/types';
import { RESERVE_MINUTES } from '../../../lib/repo/orders';
import { receiptUrl } from '../../../lib/receipt';
import { CANCEL_REASONS_CAIXA, CANCEL_REASONS_ONLINE, STAFF_CANCELABLE_ONLINE, caixaRefundPlan, cancelRequestPending, manualRefundText, returnAwaitingReview, returnDeadline, returnOpen, stockLines, stockWasOut } from '../../../lib/order-policy';
import { RETURN_KIND_LABELS } from '../../../lib/types';
import { getProducts } from '../../../lib/repo/catalog';

export const prerender = false;

const { number } = Astro.params;
const order = number ? await getOrderByNumber(number) : null;
if (!order) return Astro.redirect('/admin/pedidos');

const a = order.shipping_address;
const saved = Astro.url.searchParams.get('ok') === '1';
const savedEmail = Astro.url.searchParams.get('email') === '1';
const updateError = Astro.url.searchParams.get('erro') === 'update';
const motivo = Astro.url.searchParams.get('motivo');
const ERROS: Record<string, string> = {
  estoque: 'Não dá para marcar como pago: falta estoque de um dos produtos. Reponha o estoque e tente de novo.',
  rastreio: 'Para marcar como Enviado, informe o código de rastreio.',
  'rastreio-invalido': 'Código de rastreio inválido. Use o código dos Correios (ex.: AA123456789BR) ou o link de rastreio da transportadora.',
  'email-invalido': 'O e-mail do cliente é inválido. Desmarque "Enviar e-mail ao cliente" para salvar sem avisar.',
  email: 'Não foi possível enviar o e-mail ao cliente, então nada foi alterado. Confira o e-mail do cliente ou salve sem enviar o e-mail.',
  retrocesso: 'O status só avança: não dá para voltar a um status anterior.',
  final: 'Venda entregue ou cancelada não muda mais de status.',
  igual: 'Escolha um status diferente do atual.',
  desistencia: 'O cliente pediu a desistência desta compra: aprove o cancelamento antes de qualquer outro passo.',
  migracao: 'O banco ainda não aceita este status. Rode a migration 0024 (supabase/migrations/0024_separating_cancel_request.sql) no Supabase e tente de novo.',
};
// só os próximos status da linha do tempo (cancelar tem botão próprio); final = travado
const isFinal = FINAL_STATUSES.includes(order.status);
// rastreio visível/obrigatório de Enviado em diante
const TRACKING_STATUSES = ['shipped', 'delivered'];
const trackingOn = TRACKING_STATUSES.includes(order.status);
const COPY_ICON = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" /></svg>';
// estoque já baixou (pago ou Caixa): no cancelamento, escolher se os itens voltam
// estoque já saiu (Caixa concluído ou online pago): o cancelamento decide o que volta e o que é perda
const stockOut = stockWasOut(order);
const lines = stockLines(order, {});
// pedido do cliente esperando análise (aprovar = cancelar; recusar = responder)
const requestPending = cancelRequestPending(order);
// Caixa: o cliente leva os itens (decide quando devolver); online pago: os itens estão na loja
const stockDefault = order.source === 'caixa' ? 'later' : 'now';
const statuses = [order.status, ...ORDER_NEXT[order.status]].map((s) => [s, ORDER_STATUS_LABELS[s]]) as [OrderStatus, string][];
// aguardando pagamento: estoque reservado até a hora limite (a baixa é no pagamento)
const reservedUntil = order.status === 'pending' ? new Date(new Date(order.created_at).getTime() + RESERVE_MINUTES * 60_000) : null;
import { can } from '../../../lib/rbac';
import { takeFlash } from '../../../lib/flash';
const canStatus = can(Astro.locals.admin, 'pedidos.status');
const canCancel = can(Astro.locals.admin, 'pedidos.cancelar') && order.status !== 'cancelled';
// compra online: a equipe cancela até o envio; depois disso, só devolução
const cancelBlocked = order.source !== 'caixa' && !STAFF_CANCELABLE_ONLINE.includes(order.status);
const flash = takeFlash(Astro.cookies);
import { getPersonSummary } from '../../../lib/repo/team';
const isCaixa = order.source === 'caixa';
// quem vendeu (Caixa) e quem cancelou — nome e cargo (0023)
const [operator, canceller, stockDecider] = await Promise.all([getPersonSummary(order.operator_id), getPersonSummary(order.cancelled_by), getPersonSummary(order.stock_resolved_by)]);
// estoque pendente de um cancelamento: quem pode cancelar decide
const canDecideStock = can(Astro.locals.admin, 'pedidos.cancelar');
const created = new Date(order.created_at);
const fmtDate = (d: Date) => d.toLocaleDateString('pt-BR');
const fmtTime = (d: Date) => d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
// venda sem cadastro no Caixa: "Não identificado" no lugar de "Consumidor"/vazio
const anonymous = !order.user_id && (!order.customer_name || order.customer_name === 'Consumidor');
const customerName = anonymous ? 'Não identificado' : order.customer_name || order.customer_email || 'Não identificado';
// dinheiro: recebido e troco (pagamento simples guarda o recebido; combinado, a parte em dinheiro)
const cashPart = order.payments?.find((p) => p.method === 'cash');
const received = order.payment_method === 'cash' ? order.received_cents ?? null : null;
const change = received != null ? Math.max(0, received - order.total_cents) : cashPart ? Math.max(0, (order.payments ?? []).reduce((t, p) => t + p.amount_cents, 0) - order.total_cents) : null;
const CANCEL_REASONS = order.source === 'caixa' ? CANCEL_REASONS_CAIXA : CANCEL_REASONS_ONLINE;
// quem cancelou: o próprio cliente ou alguém da equipe (nome e cargo)
// venda do Caixa: o que volta por Pix (Mercado Pago) e o que a equipe devolve à mão
const caixaPlan = caixaRefundPlan(order);
// texto da confirmação final do cancelamento: diz se vai estornar e quanto
const refundOnCancel = !isCaixa && RECEIVED_STATUSES.includes(order.status) && !!order.mp_payment_id;
const cancelConfirm = `Confirmar o cancelamento da venda ${orderLabel(order.order_number)}?|${
  refundOnCancel
    ? `O valor de ${brl(order.total_cents)} será estornado agora ao cliente pelo Mercado Pago. Não dá para desfazer.`
    : isCaixa
      ? `${caixaPlan.pixCents ? `${brl(caixaPlan.pixCents)} em Pix serão estornados agora ao cliente pelo Mercado Pago. ` : ''}${caixaPlan.manual.length ? `Devolva ao cliente ${manualRefundText(caixaPlan.manual)}. ` : ''}Não dá para desfazer.`
      : 'Não dá para desfazer.'
}|Confirmar cancelamento|Voltar`;
// comprovante (link assinado) para reimprimir ou reenviar vendas do Caixa
const receipt = order.source === 'caixa' && order.status !== 'pending' && order.status !== 'failed' ? receiptUrl(order) : '';
const cancelledByCustomer = !!order.cancelled_by && order.cancelled_by === order.user_id;
// troca/devolução (duas etapas): quem pode cancelar aprova/recusa e, com os itens na loja, conclui
const canReturn = can(Astro.locals.admin, 'pedidos.cancelar') && order.status === 'delivered';
const returnPending = returnOpen(order);
const returnReview = returnAwaitingReview(order);
const returnWaitingItems = returnPending && !!order.return_approved_at;
const returnKind = order.return_kind ?? 'devolucao';
const returnWhat = returnKind === 'troca' ? 'troca' : 'devolução';
// itens da troca: o catálogo ativo (padrão: os mesmos produtos do pedido)
const exchangeProducts = canReturn && returnWaitingItems ? await getProducts({}) : [];
const returnConfirm = (troca: boolean) =>
  troca
    ? `Confirmar a troca?|Cria o pedido de reenvio (R$ 0) com os itens escolhidos e tira-os do estoque. O que você marcou volta ao estoque; o resto fica como perda. Não dá para desfazer.|Confirmar troca|Voltar|primary`
    : `Confirmar a devolução?|${order.mp_payment_id ? `O valor total de ${brl(order.total_cents)} (produtos + frete) será estornado agora pelo Mercado Pago` : 'O pedido'} e o pedido fica Cancelado. Não dá para desfazer.|Confirmar devolução|Voltar|primary`;
---

<AdminLayout title={`Venda ${orderLabel(order.order_number)}`}>
  <a href="/admin/pedidos" class="font-sans text-[12px] uppercase tracking-[0.12em] text-ink-muted hover:text-ink">← Vendas</a>

  {flash && (
    <p role="status" class:list={['mt-4 rounded-card border px-3 py-2 text-sm', flash.type === 'ok' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-300 bg-red-50 text-red-800']}>{flash.text}</p>
  )}
  {saved && (
    <p role="status" class="mt-4 rounded-card border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">
      {savedEmail ? 'Status atualizado e e-mail enviado ao cliente.' : 'Status atualizado.'}
    </p>
  )}
  {updateError && (
    <p role="alert" class="mt-4 rounded-card border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">
      {ERROS[motivo ?? ''] ?? 'Não foi possível atualizar o status. Tente de novo.'}
    </p>
  )}
  {/* pedido de cancelamento do cliente esperando análise */}
  {requestPending && (
    <div role="alert" class="mt-4 rounded-card border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
      <p class="font-semibold">! Solicitação de Cancelamento Pendente — não envie este pedido</p>
      <p class="mt-1">Em {new Date(order.cancel_requested_at!).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' })}, o cliente desistiu da compra: <strong>{order.cancel_request_reason}</strong></p>
      <p class="mt-1 text-[13px]">Pare a separação e aprove o cancelamento: o valor é estornado e você decide o que volta ao estoque e o que é perda. Enquanto isso, o status não avança.</p>
      {canCancel ? (
        <button type="button" data-open-cancel class="mt-3 rounded-card bg-red-700 px-3 py-1.5 text-[13px] text-white hover:bg-red-800">Aprovar o cancelamento</button>
      ) : <p class="mt-2 text-[12px]">Quem pode cancelar vendas aprova este pedido.</p>}
    </div>
  )}

  {order.exchange_of && (
    <p class="mt-4 rounded-card border border-agua/40 bg-agua-wash px-3 py-2 text-sm text-ink-soft">Pedido de reenvio da troca do pedido <a href={`/admin/pedidos/${order.exchange_of}`} class="text-agua-dark underline">{orderLabel(order.exchange_of)}</a> (sem custo para o cliente).</p>
  )}
  <div class="mt-4 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
    <section class="rounded-card border border-ink/10 bg-white p-5">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-lg">Itens</h2>
        <div class="flex items-center gap-2">
          {/* canal: físico (Caixa) ou digital (loja online) */}
          <span class="rounded-full bg-blush-light px-2 py-0.5 text-[11px] uppercase tracking-[0.1em] text-ink-soft">{order.source === 'caixa' ? 'Venda no caixa' : 'Venda online'}</span>
          <span class:list={['rounded-full px-2 py-0.5 text-[11px] font-medium uppercase', orderStatusBadge(order.status, order.source)]}>{orderStatusLabel(order.status, order.source)}</span>
        </div>
      </div>
      {/* itens: nome e quantidade à esquerda, total da linha à direita; espaço em vez de linhas */}
      <ul class="mt-5 space-y-3 text-sm">
        {order.items.map((i) => (
          <li class="flex items-start justify-between gap-4">
            <span class="min-w-0">
              <span class="block font-medium">{i.product_name}</span>
              <span class="block text-[12px] text-ink-muted">{i.quantity} × {brl(i.unit_price_cents)}</span>
            </span>
            <span class="whitespace-nowrap font-medium">{brl(i.unit_price_cents * i.quantity)}</span>
          </li>
        ))}
      </ul>

      {/* valores: subtotal e frete só quando o frete existe (senão subtotal = total) */}
      <dl class="mt-6 grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 text-sm">
        {order.shipping_cents > 0 && (
          <>
            <dt class="text-ink-muted">Subtotal</dt><dd class="text-right">{brl(order.subtotal_cents)}</dd>
            <dt class="text-ink-muted">Frete</dt><dd class="text-right">{brl(order.shipping_cents)}</dd>
          </>
        )}
        <dt class="self-center font-sans text-[13px] font-semibold uppercase tracking-[0.08em] text-ink-soft">Total</dt>
        <dd class="text-right font-display text-2xl font-bold text-green-700">{brl(order.total_cents)}</dd>
      </dl>

      {/* resumo do pagamento: forma, partes do combinado, recebido e troco, cada valor na linha do seu rótulo */}
      {order.payment_method && (
        <div class="mt-6 rounded-card bg-bone-50 p-4">
          <h3 class="font-sans text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-muted">Pagamento</h3>
          <dl class="mt-2 grid grid-cols-[1fr_auto] gap-x-4 gap-y-1.5 text-sm">
            <dt class="text-ink-muted">Método de pagamento</dt><dd class="text-right">{PAYMENT_METHOD_LABELS[order.payment_method]}</dd>
            {order.payments?.map((p) => (
              <>
                <dt class="text-ink-muted">{PAYMENT_METHOD_LABELS[p.method]}{p.method === 'cash' && ' (recebido)'}</dt><dd class="text-right">{brl(p.amount_cents)}</dd>
              </>
            ))}
            {received != null && (
              <>
                <dt class="text-ink-muted">Valor recebido</dt><dd class="text-right">{brl(received)}</dd>
              </>
            )}
            {change != null && (
              <>
                <dt class="text-ink-muted">Troco</dt><dd class="text-right">{brl(change)}</dd>
              </>
            )}
          </dl>
          {order.mp_payment_id && (
            <p class="mt-3 break-all font-sans text-[11px] text-ink-muted">Mercado Pago: {order.mp_payment_id}</p>
          )}
        </div>
      )}
    </section>

    <section class="space-y-4">
      {order.source === 'caixa' ? (
        <div class="rounded-card border border-ink/10 bg-white p-5">
          <h2 class="font-display text-lg">Venda presencial</h2>
          <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            <div><dt class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Operador</dt><dd class="font-medium">{operator?.name ?? '—'}</dd></div>
            <div><dt class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Cargo</dt><dd>{operator?.role ?? '—'}</dd></div>
            <div><dt class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Data</dt><dd>{fmtDate(created)}</dd></div>
            <div><dt class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Horário</dt><dd>{fmtTime(created)}</dd></div>
          </dl>
          <p class="mt-3 text-sm text-ink-soft">
            {order.status === 'cancelled'
              ? 'Venda do caixa cancelada; os itens voltaram ao estoque.'
              : 'Venda concluída e paga no caixa. Não há separação, envio ou código de rastreio para esta venda.'}
          </p>
        </div>
      ) : !canStatus || isFinal ? (
        <div class="rounded-card border border-ink/10 bg-white p-5 text-sm text-ink-soft">
          <h2 class="font-display text-lg text-ink">Status</h2>
          <p class="mt-2">{isFinal ? 'Não é possível alterar o Status da compra' : 'Seu cargo não permite mudar o status desta venda.'}</p>
          {order.tracking_code && (
            <label class="mt-3 block">
              <span class="label">Código de rastreio</span>
              <span class="relative block">
                <input class="field pr-11" value={order.tracking_code} readonly />
                <button type="button" data-copy-field class="absolute right-2 top-1/2 grid h-8 w-8 -translate-y-1/2 place-items-center rounded-full text-ink-muted hover:text-ink" aria-label="Copiar código de rastreio" title="Copiar" set:html={COPY_ICON}></button>
              </span>
              <span data-copy-ok class="mt-1 hidden text-[12px] text-green-700" role="status">Copiado!</span>
            </label>
          )}
        </div>
      ) : (
      <form
        id="status-form"
        method="POST"
        action="/api/admin/orders"
        class="rounded-card border border-ink/10 bg-white p-5"
        data-current={order.status}
        data-email={order.customer_email ?? ''}
        data-unverified={!order.mp_payment_id || order.mp_payment_id.startsWith('SIMULADO') ? '1' : undefined}
      >
        <h2 class="font-display text-lg">Atualizar status</h2>
        <input type="hidden" name="order_number" value={order.order_number} />
        <label class="label mt-3" for="status">Status da venda</label>
        {/* só o atual e os próximos da linha do tempo */}
        <select id="status" name="status" class="field" data-status-select>
          {statuses.map(([value, label]) => (
            <option value={value} selected={value === order.status}>{label}</option>
          ))}
        </select>
        {reservedUntil && (
          <p class="mt-2 text-[12px] text-ink-muted">Estoque reservado até {reservedUntil.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })} de {reservedUntil.toLocaleDateString('pt-BR')}; a baixa acontece quando o pagamento é confirmado.</p>
        )}

        {/* rastreio: aparece (e é obrigatório) de Enviado em diante; depois de enviado, com copiar */}
        <div id="tracking-wrap" class:list={['mt-3', !trackingOn && 'hidden']}>
          <label class="label" for="tracking_code">Código de rastreio <span class="text-red-600">*</span></label>
          <span class="relative block">
            <input
              id="tracking_code"
              name="tracking_code"
              class:list={['field', order.tracking_code && 'pr-11']}
              value={order.tracking_code ?? ''}
              required={trackingOn}
              disabled={!trackingOn}
              autocomplete="off"
              placeholder="AA123456789BR ou link da transportadora"
            />
            {order.tracking_code && (
              <button type="button" data-copy-field class="absolute right-2 top-1/2 grid h-8 w-8 -translate-y-1/2 place-items-center rounded-full text-ink-muted hover:text-ink" aria-label="Copiar código de rastreio" title="Copiar" set:html={COPY_ICON}></button>
            )}
          </span>
          <span data-copy-ok class="mt-1 hidden text-[12px] text-green-700" role="status">Copiado!</span>
          <p id="tracking-error" class="mt-1 hidden text-[12px] text-red-700">! Use o código dos Correios (AA123456789BR) ou um link de rastreio (https://…).</p>
        </div>

        {/* lembra a última escolha de quem opera (neste navegador) */}
        <label class="mt-3 flex items-center gap-2 text-sm text-ink-soft">
          <input type="checkbox" name="notify" id="notify" data-remember-notify />
          Enviar e-mail ao cliente
        </label>

        <button type="submit" class="btn-primary mt-4 w-full">Salvar</button>
      </form>
      )}

      {canCancel && (
        <div class="rounded-card border border-red-200 bg-white p-5">
          <h2 class="font-display text-lg">Cancelar venda</h2>
          <p class="mt-2 text-sm text-ink-soft">
            {cancelBlocked
              ? 'Venda já enviada: não dá para cancelar. Depois da entrega, o cliente pede a troca ou a devolução em Minha conta › Pedidos (até 7 dias).'
              : isCaixa
                ? 'Cancela a venda, registra a saída do valor no caixa e você decide o que volta ao estoque e o que é perda.'
                : 'Cancela a venda, estorna o valor pelo Mercado Pago (se já foi pago) e você decide o que volta ao estoque e o que é perda.'}
          </p>
          <button type="button" data-open-cancel disabled={cancelBlocked} class="mt-3 w-full rounded-card border border-red-300 px-4 py-2 text-sm text-red-700 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-40">Cancelar venda</button>
        </div>
      )}

      {/* troca/devolução pedida pelo cliente (até 7 dias depois da entrega), em duas etapas */}
      {order.return_requested_at && (
        <div class:list={['rounded-card border bg-white p-5 text-sm', returnPending ? 'border-amber-300' : 'border-ink/10']}>
          <h2 class="font-display text-lg">
            {order.return_completed_at
              ? order.return_resolution === 'troca' ? 'Troca concluída' : 'Devolução concluída'
              : order.return_rejected_at ? `Pedido de ${returnWhat} recusado`
              : returnWaitingItems ? 'Aguardando os itens do cliente'
              : `${returnKind === 'troca' ? 'Troca' : 'Devolução'} solicitada`}
          </h2>
          <p class="mt-2 text-ink-soft"><strong>{RETURN_KIND_LABELS[returnKind]}</strong> · pedida em {new Date(order.return_requested_at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' })}: {order.return_reason}</p>
          {order.return_approved_at && !order.return_rejected_at && (
            <div class="mt-2 rounded-card bg-bone-50 p-3 text-[13px] text-ink-soft">
              <p><strong>Forma de devolução:</strong> Correios{order.return_post_code ? ` · código de postagem ${order.return_post_code}` : ''}</p>
              {order.return_instructions && <p class="mt-1 whitespace-pre-line">{order.return_instructions}</p>}
            </div>
          )}
          {order.return_completed_at ? (
            <p class="mt-2 text-ink-soft">
              Concluída em {new Date(order.return_completed_at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' })}:{' '}
              {order.return_resolution === 'troca'
                ? <>itens novos no pedido de reenvio <a href={`/admin/pedidos/${order.exchange_order_number}`} class="text-agua-dark underline">{orderLabel(order.exchange_order_number ?? '')}</a>.</>
                : 'valor estornado e pedido cancelado.'}
            </p>
          ) : order.return_rejected_at ? (
            <p class="mt-2 text-ink-soft">Resposta ao cliente: {order.return_response}</p>
          ) : !canReturn ? (
            <p class="mt-2 text-[12px] text-ink-muted">Quem pode cancelar vendas cuida de trocas e devoluções.</p>
          ) : returnWaitingItems ? (
            <>
              <p class="mt-2 text-[12px] text-ink-muted">Quando os itens chegarem à loja e forem conferidos, confirme a {returnWhat}.</p>
              <button type="button" data-open-return class="btn-primary mt-3 w-full">Itens recebidos — confirmar</button>
            </>
          ) : (
            <>
              {/* etapa 1: aprovar com a forma de devolver, ou recusar com resposta */}
              <form method="POST" action="/api/admin/orders/devolucao" class="mt-3 space-y-3">
                <input type="hidden" name="order_number" value={order.order_number} />
                <input type="hidden" name="acao" value="aprovar" />
                <label class="block">
                  <span class="label">Código de postagem reversa (Correios)</span>
                  <input name="codigo_postagem" maxlength="40" class="field" placeholder="Opcional" />
                </label>
                <label class="block">
                  <span class="label">Instruções ao cliente <span class="text-red-600">*</span></span>
                  <textarea name="instrucoes" rows="4" maxlength="1000" required class="field">Embale os itens com etiquetas e acessórios (de preferência na embalagem original) e poste numa agência dos Correios usando o código de postagem reversa, em até 7 dias. A postagem é por nossa conta.</textarea>
                </label>
                <div class="grid gap-2">
                  <button class="btn-primary w-full">Aprovar e enviar instruções</button>
                  <button type="button" id="reject-open" class="rounded-card border border-ink/20 px-4 py-2 text-sm hover:bg-bone-100">Recusar</button>
                </div>
              </form>
            </>
          )}
        </div>
      )}
      {order.status === 'delivered' && !order.return_requested_at && returnDeadline(order) && (
        <p class="text-[12px] text-ink-muted">Prazo de devolução do cliente: até {returnDeadline(order)!.toLocaleDateString('pt-BR')}.</p>
      )}

      {/* estoque do cancelamento: pendente (decidir agora) ou o que voltou e o que virou perda */}
      {order.status === 'cancelled' && order.stock_pending && (
        <div class="rounded-card border border-amber-300 bg-white p-5 text-sm">
          <h2 class="font-display text-lg">Estoque pendente</h2>
          <p class="mt-1 text-[13px] text-ink-soft">Os itens deste cancelamento estão fora do estoque, aguardando a devolução. Quando chegarem, informe quantos voltam à venda; o resto fica como perda.</p>
          {canDecideStock ? (
            <form method="POST" action="/api/admin/orders/stock" class="mt-3 space-y-2" data-confirm="Confirmar o estoque deste cancelamento?|As unidades informadas voltam ao estoque; o resto fica registrado como perda. Não dá para desfazer.|Confirmar|Voltar|primary">
              <input type="hidden" name="order_number" value={order.order_number} />
              {lines.map((l) => (
                <div data-stock-line data-qty={l.quantity}>
                  <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 text-[13px]">
                    <span class="min-w-[9rem] flex-1">{l.product_name}</span>
                    <span class="flex shrink-0 items-center gap-1.5">
                      <input type="number" name={`restock_${l.product_id}`} min="0" max={l.quantity} value={l.quantity} class="field w-16 px-2 py-1 text-center" aria-label={`Unidades de ${l.product_name} que voltam ao estoque`} />
                      <span class="text-ink-muted">de {l.quantity} ao estoque</span>
                    </span>
                  </div>
                  <p data-loss class="hidden text-right text-[12px] font-medium text-red-700"></p>
                </div>
              ))}
              <button class="btn-primary mt-2 w-full">Confirmar estoque</button>
            </form>
          ) : <p class="mt-2 text-[12px] text-ink-muted">Quem pode cancelar vendas decide o estoque.</p>}
        </div>
      )}
      {(order.status === 'cancelled' || order.return_resolution === 'troca') && order.stock_resolution && (
        <div class="rounded-card border border-ink/10 bg-white p-5 text-sm">
          <h2 class="font-display text-lg">{order.return_completed_at ? `Estoque da ${order.return_resolution === 'troca' ? 'troca' : 'devolução'}` : 'Estoque do cancelamento'}</h2>
          <table class="mt-2 w-full text-left text-[13px]">
            <thead class="text-[11px] uppercase tracking-[0.08em] text-ink-muted"><tr><th class="py-1">Produto</th><th class="py-1 text-right">Ao estoque</th><th class="py-1 text-right">Perda</th></tr></thead>
            <tbody>
              {order.stock_resolution.map((l) => (
                <tr><td class="py-1">{l.product_name}</td><td class="py-1 text-right text-green-700">{l.restocked}</td><td class:list={['py-1 text-right', l.quantity - l.restocked > 0 ? 'font-medium text-red-700' : 'text-ink-muted']}>{l.quantity - l.restocked}</td></tr>
              ))}
            </tbody>
          </table>
          {order.stock_resolved_at && <p class="mt-2 text-[12px] text-ink-muted">Decidido em {new Date(order.stock_resolved_at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' })}{stockDecider ? ` por ${stockDecider.name}` : ''}.</p>}
        </div>
      )}

      {/* auditoria do cancelamento */}
      {order.status === 'cancelled' && (order.cancel_reason || order.cancelled_at) && (
        <div class="rounded-card border border-red-200 bg-white p-5 text-sm">
          <h2 class="font-display text-lg">Cancelamento</h2>
          <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
            <dt class="text-ink-muted">Por</dt><dd>{cancelledByCustomer ? `Cliente — ${customerName}` : canceller ? `${canceller.name} (${canceller.role}) · ${canceller.email}` : '—'}</dd>
            {isCaixa && <><dt class="text-ink-muted">Venda feita por</dt><dd>{operator ? `${operator.name} (${operator.role})` : '—'}</dd></>}
            <dt class="text-ink-muted">Quando</dt><dd>{order.cancelled_at ? new Date(order.cancelled_at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'medium' }) : '—'}</dd>
            <dt class="text-ink-muted">Motivo</dt><dd>{order.cancel_reason || '—'}</dd>
          </dl>
        </div>
      )}

      {/* comprovante da venda do Caixa: reimprimir ou reenviar por WhatsApp */}
      {receipt && (
        <div class="rounded-card border border-ink/10 bg-white p-5 text-sm">
          <h2 class="font-display text-lg">Comprovante</h2>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            <a href={`${receipt}?imprimir=1`} target="_blank" rel="noopener" class="btn-primary w-full">Imprimir</a>
            <a href={receipt} target="_blank" rel="noopener" class="btn-outline w-full">Ver / Baixar PDF</a>
          </div>
          <form id="wa-form" class="mt-3 flex gap-2" data-url={receipt} data-label={`${orderLabel(order.order_number)} (${brl(order.total_cents)})`}>
            <input name="phone" class="field min-w-0 flex-1" inputmode="tel" placeholder="Celular com DDD" value={order.customer_phone ? formatPhone(order.customer_phone) : ''} aria-label="Celular do cliente com DDD" />
            <button class="shrink-0 rounded-card bg-[#25D366] px-3 text-[13px] font-semibold text-white">WhatsApp</button>
          </form>
          <p id="wa-error" class="mt-1 hidden text-[12px] text-red-700">Informe o celular com DDD, ex.: (11) 99999-8888.</p>
        </div>
      )}

      {/* venda do Caixa: sem card de cliente */}
      {!isCaixa && (
      <div class="rounded-card border border-ink/10 bg-white p-5 text-sm">
        <h2 class="font-display text-lg">Cliente</h2>
        <dl class="mt-2 grid grid-cols-[auto_1fr] items-center gap-x-3 gap-y-1.5 text-ink-soft">
          <dt class="text-ink-muted">Nome:</dt>
          {/* cliente com conta: nome vira link para a ficha dele */}
          <dd>{order.user_id ? <a href={`/admin/usuarios/clientes/${order.user_id}`} class="text-agua-dark underline">{customerName}</a> : customerName}</dd>
          <dt class="text-ink-muted">Email:</dt>
          <dd class="break-all">{order.customer_email || '—'}</dd>
          <dt class="text-ink-muted">Telefone:</dt>
          <dd class="flex items-center gap-2">
            {order.customer_phone ? formatPhone(order.customer_phone) : '—'}
            {order.customer_phone && whatsappUrl(order.customer_phone) && (
              <a href={whatsappUrl(order.customer_phone)} target="_blank" rel="noopener" class="grid h-7 w-7 place-items-center rounded-full bg-[#25D366] text-white hover:brightness-95" aria-label="Conversar no WhatsApp" title="Conversar no WhatsApp">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z" /></svg>
              </a>
            )}
          </dd>
          <dt class="text-ink-muted">CPF:</dt>
          <dd>{order.customer_cpf ? formatCpf(order.customer_cpf) : '—'}</dd>
        </dl>
      </div>
      )}
      <div class="rounded-card border border-ink/10 bg-white p-5 text-sm">
        <h2 class="font-display text-lg">Entrega</h2>
        {isCaixa || !a?.street ? (
          <p class="mt-2 text-ink-soft">Retirada presencial / Balcão</p>
        ) : (
          <>
            <p class="mt-2 text-ink-soft">
              {a.street}, {a.number}{a.complement ? ` — ${a.complement}` : ''}<br />
              {a.district} — {a.city}/{a.state}<br />
              CEP {a.cep}
            </p>
            <button type="button" data-copy={`${a.street}, ${a.number}${a.complement ? ` - ${a.complement}` : ''} - ${a.district} - ${a.city}/${a.state} - CEP ${a.cep}`} class="mt-3 rounded-card border border-ink/20 px-3 py-1 text-[12px] hover:bg-bone-100">Copiar endereço</button>
          </>
        )}
      </div>
      {canCancel && (
        <dialog id="cancel-dialog" class="m-auto w-[min(92vw,28rem)] rounded-card border border-ink/10 bg-bone p-0 text-ink shadow-xl backdrop:bg-ink/50">
          {/* segunda confirmação antes de cancelar (e estornar): o botão vermelho sozinho não basta */}
          <form method="POST" action="/api/admin/orders/cancel" class="space-y-4 p-6" data-confirm={cancelConfirm}>
            <input type="hidden" name="order_number" value={order.order_number} />
            <h2 class="font-display text-xl">Cancelar a venda {orderLabel(order.order_number)}?</h2>
            <p class="text-sm text-ink-soft">
              O valor sai dos totais recebidos.
              {RECEIVED_STATUSES.includes(order.status) && (order.source === 'caixa'
                ? ` ${caixaPlan.pixCents ? 'O Pix é estornado automaticamente pelo Mercado Pago.' : ''}${caixaPlan.manual.length ? ` Devolva ao cliente ${manualRefundText(caixaPlan.manual)}.` : ''}`
                : ' O valor é estornado automaticamente pelo Mercado Pago e o cliente recebe um e-mail; se o estorno falhar, nada é cancelado.')}
            </p>
            {requestPending ? (
              <div>
                <span class="label">Motivo (pedido do cliente)</span>
                <p class="rounded-card bg-bone-50 px-3 py-2 text-sm">{order.cancel_request_reason}</p>
              </div>
            ) : (
              <>
                <label class="block">
                  <span class="label">Motivo <span class="text-red-600">*</span></span>
                  <select id="cancel-motivo" name="motivo" class="field" required>
                    <option value="" disabled selected>Selecione o motivo</option>
                    {CANCEL_REASONS.map((r) => <option value={r}>{r}</option>)}
                  </select>
                </label>
                <label id="cancel-detalhe-wrap" class="block hidden">
                  <span class="label">Detalhes <span class="text-red-600">*</span></span>
                  <textarea id="cancel-detalhe" name="detalhe" rows="3" maxlength="400" class="field" disabled></textarea>
                </label>
              </>
            )}
            {requestPending && (
              <label class="flex items-start gap-2 rounded-card border border-amber-300 bg-amber-50 p-3 text-[13px] text-amber-900">
                <input type="checkbox" required class="mt-0.5" />
                <span>Confirmo que <strong>parei a separação</strong> deste pedido e que ele não será enviado.</span>
              </label>
            )}
            {/* estoque por item e quantidade: o que não volta vira perda (avaria) */}
            {stockOut ? (
              <fieldset class="min-w-0 space-y-2" data-stock-box>
                <legend class="label">Estoque</legend>
                <label class="flex items-start gap-2 text-[13px]"><input type="radio" name="stock_mode" value="now" class="mt-0.5" checked={stockDefault === 'now'} /> <span><strong>Decidir agora</strong> — os itens estão na loja</span></label>
                <label class="flex items-start gap-2 text-[13px]"><input type="radio" name="stock_mode" value="later" class="mt-0.5" checked={stockDefault === 'later'} /> <span><strong>Decidir depois</strong> — aguardando o cliente devolver os itens (ficam fora do estoque até lá)</span></label>
                <div data-stock-now class:list={['space-y-2 rounded-card bg-bone-50 p-3', stockDefault === 'later' && 'hidden']}>
                  {lines.map((l) => (
                    <div data-stock-line data-qty={l.quantity}>
                      <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 text-[13px]">
                        <span class="min-w-[9rem] flex-1">{l.product_name}</span>
                        <span class="flex shrink-0 items-center gap-1.5">
                          <input type="number" name={`restock_${l.product_id}`} min="0" max={l.quantity} value={l.quantity} class="field w-16 px-2 py-1 text-center" aria-label={`Unidades de ${l.product_name} que voltam ao estoque`} />
                          <span class="text-ink-muted">de {l.quantity} ao estoque</span>
                        </span>
                      </div>
                      <p data-loss class="hidden text-right text-[12px] font-medium text-red-700"></p>
                    </div>
                  ))}
                  <p class="text-[11px] text-ink-muted">O que não voltar ao estoque fica registrado como perda (produto quebrado, violado ou danificado).</p>
                </div>
              </fieldset>
            ) : (
              <p class="text-[12px] text-ink-muted">Nada saiu do estoque (pagamento não confirmado): não há o que devolver.</p>
            )}
            {!isCaixa && (
              <label class="flex items-center gap-2 text-[13px] text-ink-soft">
                <input type="checkbox" name="notify" data-remember-notify />
                Enviar e-mail ao cliente
              </label>
            )}
            <div class="flex justify-end gap-2">
              <button type="button" id="cancel-close" class="rounded-card border border-ink/20 px-4 py-2 font-sans text-sm hover:bg-bone-200">Voltar</button>
              <button class="rounded-card bg-red-700 px-4 py-2 font-sans text-sm text-white hover:bg-red-800">Cancelar venda</button>
            </div>
          </form>
        </dialog>
      )}
      {canReturn && returnReview && (
        <dialog id="reject-dialog" class="m-auto w-[min(92vw,28rem)] rounded-card border border-ink/10 bg-bone p-0 text-ink shadow-xl backdrop:bg-ink/50">
          <form method="POST" action="/api/admin/orders/devolucao" class="space-y-4 p-6">
            <input type="hidden" name="order_number" value={order.order_number} />
            <input type="hidden" name="acao" value="recusar" />
            <h2 class="font-display text-xl">Recusar a {returnWhat}?</h2>
            <p class="text-sm text-ink-soft">O pedido continua Entregue. A resposta vai por e-mail ao cliente e aparece em Minha conta. Os 7 dias são direito do cliente: recuse só o que está fora das condições da política.</p>
            <label class="block">
              <span class="label">Resposta ao cliente <span class="text-red-600">*</span></span>
              <textarea name="resposta" rows="4" minlength="5" maxlength="500" required class="field" placeholder="Ex.: as fotos mostram sinais de uso além da prova; fale com a gente para avaliarmos."></textarea>
            </label>
            <div class="flex justify-end gap-2">
              <button type="button" id="reject-close" class="rounded-card border border-ink/20 px-4 py-2 font-sans text-sm hover:bg-bone-200">Voltar</button>
              <button class="rounded-card bg-ink px-4 py-2 font-sans text-sm text-bone">Recusar e responder</button>
            </div>
          </form>
        </dialog>
      )}
      {canReturn && returnWaitingItems && (
        <dialog id="return-dialog" class="m-auto w-[min(92vw,32rem)] rounded-card border border-ink/10 bg-bone p-0 text-ink shadow-xl backdrop:bg-ink/50">
          {/* mesma janela da Confirmação de Cancelamento, para os itens que voltaram */}
          <form id="return-form" method="POST" action="/api/admin/orders/devolucao" class="space-y-4 p-6" data-confirm={returnConfirm(returnKind === 'troca')} data-confirm-troca={returnConfirm(true)} data-confirm-reembolso={returnConfirm(false)}>
            <input type="hidden" name="order_number" value={order.order_number} />
            <input type="hidden" name="acao" value="concluir" />
            <h2 class="font-display text-xl">Confirmação de troca ou devolução</h2>
            <p class="text-sm text-ink-soft">Use quando os itens devolvidos chegarem à loja e forem conferidos. O cliente pediu: <strong>{RETURN_KIND_LABELS[returnKind]}</strong> — {order.return_reason}</p>
            <fieldset class="min-w-0 space-y-2">
              <legend class="label">Resolução</legend>
              <label class="flex items-start gap-2 text-[13px]">
                <input type="radio" name="resolucao" value="reembolso" class="mt-0.5" checked={returnKind !== 'troca'} />
                <span><strong>Reembolso integral</strong> — {brl(order.subtotal_cents)} em produtos + {order.shipping_cents ? brl(order.shipping_cents) : 'R$ 0,00'} de frete = <strong>{brl(order.total_cents)}</strong>, estornado pelo Mercado Pago. O pedido fica Cancelado.</span>
              </label>
              <label class="flex items-start gap-2 text-[13px]">
                <input type="radio" name="resolucao" value="troca" class="mt-0.5" checked={returnKind === 'troca'} />
                <span><strong>Troca</strong> — cria um pedido de reenvio (R$ 0) com os itens abaixo, já como Pago; separe e envie por ele.</span>
              </label>
            </fieldset>
            <div data-exchange-box class="space-y-2 rounded-card bg-bone-50 p-3">
              <p class="label">Itens que vão para o cliente</p>
              {order.items.map((it, n) => (
                <div class="flex items-center gap-2">
                  <select name={`troca_product_${n}`} class="field min-w-0 flex-1 py-1 text-[13px]" aria-label="Produto da troca">
                    {!exchangeProducts.some((p) => p.id === it.product_id) && <option value={it.product_id} selected>{it.product_name}</option>}
                    {exchangeProducts.map((p) => <option value={p.id} selected={p.id === it.product_id}>{p.name} ({p.stock} em estoque)</option>)}
                  </select>
                  <input type="number" name={`troca_qty_${n}`} min="0" max="99" value={it.quantity} class="field w-16 px-2 py-1 text-center" aria-label="Quantidade" />
                </div>
              ))}
              <p class="text-[11px] text-ink-muted">Quantidade 0 tira o item. A troca é por produto de mesmo valor (política de trocas).</p>
            </div>
            <fieldset class="min-w-0 space-y-2">
              <legend class="label">Estoque dos itens devolvidos</legend>
              <div class="space-y-2 rounded-card bg-bone-50 p-3">
                {lines.map((l) => (
                  <div data-stock-line data-qty={l.quantity}>
                    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 text-[13px]">
                      <span class="min-w-[9rem] flex-1">{l.product_name}</span>
                      <span class="flex shrink-0 items-center gap-1.5">
                        <input type="number" name={`restock_${l.product_id}`} min="0" max={l.quantity} value={/defeito|avaria/i.test(order.return_reason ?? '') ? 0 : l.quantity} class="field w-16 px-2 py-1 text-center" aria-label={`Unidades de ${l.product_name} que voltam ao estoque`} />
                        <span class="text-ink-muted">de {l.quantity} ao estoque</span>
                      </span>
                    </div>
                    <p data-loss class="hidden text-right text-[12px] font-medium text-red-700"></p>
                  </div>
                ))}
                <p class="text-[11px] text-ink-muted">O que não voltar ao estoque fica registrado como perda (defeito, avaria ou sinais de uso).</p>
              </div>
            </fieldset>
            <p class="text-[12px] text-ink-muted">O cliente recebe um e-mail com o resultado.</p>
            <div class="flex justify-end gap-2">
              <button type="button" id="return-close" class="rounded-card border border-ink/20 px-4 py-2 font-sans text-sm hover:bg-bone-200">Voltar</button>
              <button class="btn-primary">Confirmar</button>
            </div>
          </form>
        </dialog>
      )}
      <p class="font-sans text-[12px] text-ink-muted">
        Criado em {new Date(order.created_at).toLocaleString('pt-BR')}
      </p>
    </section>
  </div>
</AdminLayout>

<script>
  import { enableConfirmForms } from '../../../lib/confirm-forms';
  import { confirmDialog } from '../../../lib/confirm-dialog';
  enableConfirmForms();

  // cancelar: motivo obrigatório ("Outro" exige o texto)
  const dlg = document.getElementById('cancel-dialog') as HTMLDialogElement | null;
  const motivo = document.getElementById('cancel-motivo') as HTMLSelectElement | null;
  const detalhe = document.getElementById('cancel-detalhe') as HTMLTextAreaElement | null;
  document.querySelectorAll<HTMLButtonElement>('[data-open-cancel]').forEach((b) => b.addEventListener('click', () => dlg?.showModal()));
  document.getElementById('cancel-close')?.addEventListener('click', () => dlg?.close());
  const returnDlg = document.getElementById('return-dialog') as HTMLDialogElement | null;
  document.querySelectorAll<HTMLButtonElement>('[data-open-return]').forEach((b) => b.addEventListener('click', () => returnDlg?.showModal()));
  document.getElementById('return-close')?.addEventListener('click', () => returnDlg?.close());
  // resolução: Troca mostra os itens novos; a confirmação final acompanha a escolha
  const returnForm = document.getElementById('return-form') as HTMLFormElement | null;
  const syncResolution = () => {
    if (!returnForm) return;
    const troca = (returnForm.querySelector('input[name=resolucao]:checked') as HTMLInputElement | null)?.value === 'troca';
    const box = returnForm.querySelector<HTMLElement>('[data-exchange-box]')!;
    box.classList.toggle('hidden', !troca);
    box.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((i) => (i.disabled = !troca));
    returnForm.dataset.confirm = troca ? returnForm.dataset.confirmTroca : returnForm.dataset.confirmReembolso;
  };
  returnForm?.querySelectorAll('input[name=resolucao]').forEach((r) => r.addEventListener('change', syncResolution));
  syncResolution();
  const rejectDlg = document.getElementById('reject-dialog') as HTMLDialogElement | null;
  document.getElementById('reject-open')?.addEventListener('click', () => rejectDlg?.showModal());
  document.getElementById('reject-close')?.addEventListener('click', () => rejectDlg?.close());

  // estoque: "Decidir agora" mostra os itens; cada item mostra quantas unidades viram perda
  document.querySelectorAll<HTMLInputElement>('input[name=stock_mode]').forEach((r) =>
    r.addEventListener('change', () => {
      const now = (document.querySelector('input[name=stock_mode]:checked') as HTMLInputElement | null)?.value === 'now';
      const box = document.querySelector<HTMLElement>('[data-stock-now]');
      box?.classList.toggle('hidden', !now);
      box?.querySelectorAll('input').forEach((i) => (i.disabled = !now));
    }),
  );
  document.querySelector<HTMLInputElement>('input[name=stock_mode]:checked')?.dispatchEvent(new Event('change'));
  document.querySelectorAll<HTMLElement>('[data-stock-line]').forEach((line) => {
    const qty = Number(line.dataset.qty);
    const input = line.querySelector('input')!;
    const loss = line.querySelector<HTMLElement>('[data-loss]')!;
    const sync = () => {
      const back = Math.max(0, Math.min(qty, Math.floor(Number(input.value) || 0)));
      const lost = qty - back;
      loss.textContent = lost ? `→ ${lost} ${lost === 1 ? 'unidade vai' : 'unidades vão'} para perda (avaria)` : '';
      loss.classList.toggle('hidden', !lost);
      input.classList.toggle('border-red-400', lost > 0);
    };
    input.addEventListener('input', sync);
    sync();
  });
  // Detalhes só aparece (e é obrigatório) em "Outro"
  motivo?.addEventListener('change', () => {
    const other = motivo.value === 'Outro';
    document.getElementById('cancel-detalhe-wrap')?.classList.toggle('hidden', !other);
    if (detalhe) {
      detalhe.required = other;
      detalhe.disabled = !other;
    }
  });

  // "Enviar e-mail ao cliente": lembra a escolha (localStorage) até mudar de novo
  const NOTIFY_KEY = 'compras-enviar-email';
  let savedNotify = false;
  try {
    savedNotify = localStorage.getItem(NOTIFY_KEY) === '1';
  } catch {}
  document.querySelectorAll<HTMLInputElement>('[data-remember-notify]').forEach((box) => {
    box.checked = savedNotify;
    box.addEventListener('change', () => {
      try {
        localStorage.setItem(NOTIFY_KEY, box.checked ? '1' : '0');
      } catch {}
    });
  });

  // copiar o código de rastreio
  document.querySelectorAll<HTMLButtonElement>('[data-copy-field]').forEach((b) =>
    b.addEventListener('click', async () => {
      const input = b.parentElement!.querySelector('input')!;
      const ok = b.closest('label, div')!.querySelector<HTMLElement>('[data-copy-ok]');
      try {
        await navigator.clipboard.writeText(input.value);
        if (ok) ok.textContent = 'Copiado!';
      } catch {
        if (ok) ok.textContent = 'Não deu para copiar';
      }
      ok?.classList.remove('hidden');
      setTimeout(() => ok?.classList.add('hidden'), 2000);
    }),
  );

  // comprovante por WhatsApp: abre o WhatsApp do caixa com a mensagem e o link prontos
  document.getElementById('wa-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.currentTarget as HTMLFormElement;
    let d = ((f.elements.namedItem('phone') as HTMLInputElement).value || '').replace(/\D/g, '');
    if (d.length > 11 && d.startsWith('55')) d = d.slice(2);
    const err = document.getElementById('wa-error')!;
    err.classList.toggle('hidden', d.length >= 10);
    if (d.length < 10) return;
    const text = `Olá! Segue o comprovante da sua compra ${f.dataset.label}: ${f.dataset.url}`;
    window.open(`https://wa.me/55${d}?text=${encodeURIComponent(text)}`, '_blank');
  });

  // ---- status: rastreio só em Enviado, e-mail marcado só em mudança relevante ----
  const statusForm = document.getElementById('status-form') as HTMLFormElement | null;
  const statusSel = document.querySelector<HTMLSelectElement>('[data-status-select]');
  const tracking = document.getElementById('tracking_code') as HTMLInputElement | null;
  const trackingError = document.getElementById('tracking-error');
  const notify = document.getElementById('notify') as HTMLInputElement | null;
  const current = statusForm?.dataset.current ?? '';
  const customerEmail = statusForm?.dataset.email ?? '';
  // mesmo formato do servidor (isValidTracking em lib/types)
  const validTracking = (v: string) => {
    const t = v.trim();
    if (/^[A-Z]{2}\d{9}[A-Z]{2}$/.test(t.toUpperCase())) return true;
    try {
      const u = new URL(t);
      return /^https?:$/.test(u.protocol) && /\.[a-z]{2,}$/i.test(u.hostname);
    } catch {
      return false;
    }
  };
  statusSel?.addEventListener('change', () => {
    const on = ['shipped', 'delivered'].includes(statusSel.value);
    document.getElementById('tracking-wrap')?.classList.toggle('hidden', !on);
    if (tracking) {
      tracking.required = on;
      tracking.disabled = !on;
    }
  });
  tracking?.addEventListener('input', () => {
    tracking.setCustomValidity('');
    trackingError?.classList.add('hidden');
  });
  statusForm?.addEventListener('submit', async (e) => {
    if (statusForm.dataset.confirmed) return;
    e.preventDefault();
    if (tracking && !tracking.disabled && !validTracking(tracking.value)) {
      trackingError?.classList.remove('hidden');
      tracking.focus();
      return;
    }
    // aviso marcado + e-mail inválido: não salva (desmarcado salva sem avisar)
    if (notify?.checked && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(customerEmail)) {
      await confirmDialog({
        title: 'E-mail do cliente inválido',
        message: 'Não dá para enviar o aviso. Desmarque "Enviar e-mail ao cliente" para salvar sem avisar.',
        confirmLabel: 'Entendi',
        cancelLabel: 'Fechar',
        tone: 'primary',
      });
      return;
    }
    // Pago é do Mercado Pago (webhook): marcar à mão pede confirmação
    if (statusSel?.value === 'paid' && current !== 'paid') {
      const ok = await confirmDialog({
        title: 'Aprovar pagamento manualmente?',
        message: 'Confirma a aprovação manual deste pagamento sem a validação do gateway?',
        confirmLabel: 'Confirmar',
        cancelLabel: 'Voltar',
        tone: 'primary',
      });
      if (!ok) return;
    }
    // pagamento que o gateway não confirmou (simulado/sem id) indo para Em separação
    if (statusSel?.value === 'separating' && current !== 'separating' && statusForm.dataset.unverified) {
      const ok = await confirmDialog({
        title: 'Pagamento sem confirmação',
        message: 'Confirma a aprovação manual deste pagamento sem a validação de recebimento?',
        confirmLabel: 'Confirmar',
        cancelLabel: 'Voltar',
        tone: 'primary',
      });
      if (!ok) return;
    }
    statusForm.dataset.confirmed = '1';
    statusForm.requestSubmit();
  });

  // "Copiar endereço": linha pronta para etiqueta dos Correios/transportadora
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.textContent = 'Copiado ✓';
      } catch {
        b.textContent = 'Não deu para copiar';
      }
      setTimeout(() => (b.textContent = 'Copiar endereço'), 2000);
    }),
  );
</script>
