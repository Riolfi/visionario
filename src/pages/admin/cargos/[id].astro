---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { RULES, SCREENS } from '../../../lib/rbac';
import { listPermissions, listRoles, type Permission } from '../../../lib/repo/roles';
import { listTeam } from '../../../lib/repo/team';
import { takeFlash } from '../../../lib/flash';

export const prerender = false;

const access = Astro.locals.admin!;
const id = Astro.params.id ?? '';
const isNew = id === 'novo';
const [roles, permissions] = await Promise.all([listRoles(), listPermissions().catch(() => [] as Permission[])]);
const role = isNew ? null : roles.find((r) => r.id === id);
if (!isNew && !role) return Astro.redirect('/admin/cargos');
const isAdminRole = !!role?.is_owner;
// quem tem o cargo (para o aviso de não poder excluir)
const members = role ? (await listTeam().catch(() => [])).filter((m) => m.role_id === role.id).map((m) => m.name || m.email) : [];
const flash = takeFlash(Astro.cookies);
// telas que cada permissão cobre (pelas regras dela)
const screensOf = (rules: string[]) =>
  SCREENS.filter((s) => RULES.some((r) => r.screen === s.key && rules.includes(r.key))).map((s) => s.label).join(', ');
// quem não é Administrador só usa permissões com acessos que ele tem (o servidor confere)
const outOfReach = (p: Permission) => !access.isOwner && p.rules.some((r) => !access.rules.includes(r));
const deleteBlock = isAdminRole ? 'admin' : members.length ? 'members' : '';
---

<AdminLayout title={isNew ? 'Novo cargo' : 'Cargo'}>
  <a href="/admin/cargos" class="font-sans text-[12px] uppercase tracking-[0.12em] text-ink-muted hover:text-ink">← Cargos</a>

  {flash && (
    <p role="status" class:list={['mt-4 max-w-2xl rounded-card border px-3 py-2 text-sm', flash.type === 'ok' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-300 bg-red-50 text-red-800']}>{flash.text}</p>
  )}
  {/* avisos do salvar (preenchidos pelo script, sem recarregar a tela) */}
  <div id="top-notice" role="alert" class="notice-in mt-4 hidden max-w-2xl rounded-[14px] border border-red-200 bg-red-50 px-3 py-2 font-sans text-[13px] text-red-700"></div>

  <form id="role-form" method="POST" action="/api/admin/roles" class="mt-4 max-w-2xl space-y-5">
    <input type="hidden" name="acao" value="salvar" />
    <input type="hidden" name="id" value={role?.id ?? ''} />
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block"><span class="label">Nome</span><input class="field" name="name" value={role?.name ?? ''} required minlength="2" maxlength="60" placeholder="Ex.: Atendente" /></label>
      <label class="block"><span class="label">Descrição <span class="text-[11px] font-normal text-ink-muted/60">(opcional)</span></span><input class="field" name="description" value={role?.description ?? ''} maxlength="200" /></label>
    </div>

    {isAdminRole ? (
      <>
        <div class="rounded-card border border-ink/10 bg-white px-4 py-3 text-sm text-ink-soft">
          Acesso total, inclusive Permissões e Cargos. Não pode ser excluído e precisa ter pelo menos uma pessoa.
        </div>
        <p class="text-sm text-ink-soft">
          Proprietário (responsável legal da conta): <strong>{role?.owner_email ?? 'rode a migration 0019'}</strong>.
          Para passar a posse, o Proprietário atual liga “Proprietário” na tela do outro Administrador, em <a href="/admin/usuarios?aba=equipe" class="underline">Usuários</a>.
        </p>
      </>
    ) : (
      <>
        <fieldset class="rounded-card border border-ink/10 bg-white">
          <legend class="sr-only">Permissões</legend>
          <h2 class="border-b border-ink/10 px-4 py-3 font-display text-lg" aria-hidden="true">Permissões</h2>
          {permissions.length ? (
            <div class="divide-y divide-ink/10">
              {permissions.map((p) => (
                <label class:list={['flex items-start gap-3 px-4 py-3', outOfReach(p) ? 'cursor-not-allowed opacity-50' : 'cursor-pointer hover:bg-bone-50']} title={outOfReach(p) ? 'Tem acessos que você não tem' : undefined}>
                  <input type="checkbox" name="permissions" value={p.id} checked={role?.permission_ids.includes(p.id)} disabled={outOfReach(p)} class="mt-1 h-4 w-4 shrink-0" />
                  <span class="min-w-0">
                    <span class="block text-sm font-medium">{p.name}{!p.is_active && <span class="ml-1 text-[11px] font-normal text-ink-muted">(inativa)</span>}</span>
                    <span class="block text-[12px] text-ink-muted">{p.description || screensOf(p.rules)}</span>
                  </span>
                </label>
              ))}
            </div>
          ) : (
            <p class="px-4 py-3 text-sm text-ink-muted">Nenhuma permissão criada. Crie em <a href="/admin/permissoes" class="underline">Permissões</a>.</p>
          )}
        </fieldset>

        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="is_active" checked={role?.is_active ?? true} />
          Ativo (quem tem este cargo acessa as telas das permissões)
        </label>
      </>
    )}

    <p id="delete-notice" role="alert" class="notice-in hidden rounded-[14px] border border-red-200 bg-red-50 px-3 py-2 font-sans text-[13px] text-red-700">
      {deleteBlock === 'admin' ? (
        '! O cargo Administrador não pode ser excluído.'
      ) : (
        <>
          ! {members.length === 1 ? 'O usuário' : 'Os usuários'} <strong>{members.join(', ')}</strong> {members.length === 1 ? 'usa' : 'usam'} este cargo. Remova em <a href="/admin/usuarios?aba=equipe" class="underline">Usuários</a> antes de excluir.
        </>
      )}
    </p>
    <div class="grid grid-cols-3 gap-3 pt-2">
      <button type="submit" id="save-btn" class="btn-primary w-full">Salvar</button>
      <button type="button" id="cancel-btn" class="btn-outline w-full">Cancelar</button>
      {/* não pode excluir: continua visível, mas apagado; o clique explica por quê */}
      <button type="button" id="delete-btn" class:list={['btn-outline w-full', deleteBlock && 'cursor-not-allowed opacity-40']} aria-disabled={deleteBlock ? 'true' : undefined}>Excluir</button>
    </div>
  </form>

  {role && !isAdminRole && (
    <form id="delete-form" method="POST" action="/api/admin/roles" class="hidden">
      <input type="hidden" name="acao" value="excluir" />
      <input type="hidden" name="id" value={role.id} />
    </form>
  )}

</AdminLayout>

<script define:vars={{ deleteBlock, isNew, roleName: role?.name ?? '', isAdminRole }}>
  window.__role = { deleteBlock, isNew, roleName, isAdminRole };
</script>

<script>
  import { confirmDialog } from '../../../lib/confirm-dialog';

  const { deleteBlock, isNew, roleName, isAdminRole } = (window as any).__role as {
    deleteBlock: string;
    isNew: boolean;
    roleName: string;
    isAdminRole: boolean;
  };
  const form = document.getElementById('role-form') as HTMLFormElement;
  const top = document.getElementById('top-notice')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  function showTop(text: string, link?: { href: string; label: string }) {
    top.textContent = `! ${text}`;
    if (link) {
      const a = document.createElement('a');
      a.href = link.href;
      a.textContent = link.label;
      a.className = 'mt-1 block font-semibold underline';
      top.appendChild(a);
    }
    top.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    // como no produto: sempre confirma como vai ficar (o Administrador é sempre ativo)
    if (!isAdminRole) {
      const active = (form.querySelector('input[name=is_active]') as HTMLInputElement).checked;
      const ok = await confirmDialog({
        title: `Deseja salvar como ${active ? 'ativo' : 'inativo'}?`,
        message: active ? 'Quem tem este cargo acessa as telas das permissões dele.' : 'Quem tem este cargo fica sem acesso a nenhuma tela.',
        confirmLabel: 'Sim',
        cancelLabel: 'Não',
        tone: 'primary',
      });
      if (!ok) return;
    }

    saveBtn.disabled = true;
    top.classList.add('hidden');
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
      const r = (await res.json().catch(() => ({}))) as { ok?: boolean; id?: string; error?: string; existingId?: string };
      if (r.ok && r.id) return void (window.location.href = `/admin/cargos/${r.id}`);
      if (r.existingId) showTop('Já existe um cargo com esse nome e regras.', { href: `/admin/cargos/${r.existingId}`, label: 'Abrir cargo existente' });
      else showTop(r.error || 'Não foi possível salvar.');
    } catch {
      showTop('Sem conexão com o servidor.');
    } finally {
      saveBtn.disabled = false;
    }
  });

  document.getElementById('cancel-btn')!.addEventListener('click', async () => {
    const leave = await confirmDialog({ title: 'Sair e perder alterações?', confirmLabel: 'Sair', cancelLabel: 'Manter alterações' });
    if (leave) window.location.href = '/admin/cargos';
  });

  document.getElementById('delete-btn')!.addEventListener('click', async () => {
    if (deleteBlock) {
      const n = document.getElementById('delete-notice')!;
      n.classList.remove('hidden', 'notice-in');
      void n.offsetWidth; // repete a animação a cada clique
      n.classList.add('notice-in');
      return;
    }
    if (isNew) {
      const discard = await confirmDialog({ title: 'Descartar este cadastro?', message: 'Nada foi salvo ainda.', confirmLabel: 'Descartar' });
      if (discard) window.location.href = '/admin/cargos';
      return;
    }
    const ok = await confirmDialog({ title: 'Excluir cargo?', message: `"${roleName}" será excluído. Isso não pode ser desfeito.` });
    if (ok) (document.getElementById('delete-form') as HTMLFormElement).submit();
  });
</script>
