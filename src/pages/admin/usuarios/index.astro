---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ListFilter from '../../../components/ListFilter.tsx';
import { can } from '../../../lib/rbac';
import { isOnline, listTeam } from '../../../lib/repo/team';
import { listRoles } from '../../../lib/repo/roles';
import { getOwnerEmail } from '../../../lib/repo/owner';
import { CUSTOMER_STATUS_LABELS, listCustomers } from '../../../lib/repo/customers';
import { formatCpf, formatPhone } from '../../../lib/format';
import { takeFlash } from '../../../lib/flash';

export const prerender = false;

const access = Astro.locals.admin!;
const canTeam = can(access, 'equipe.ver');
// criar: Administradores ou "Criar/editar usuários" (o servidor confere de novo)
const canManageTeam = can(access, 'equipe.gerenciar');
const canCustomers = can(access, 'clientes.ver');
const tabs = [canTeam && ['equipe', 'Equipe'], canCustomers && ['clientes', 'Clientes']].filter(Boolean) as [string, string][];
const wanted = Astro.url.searchParams.get('aba');
const aba = tabs.find(([k]) => k === wanted)?.[0] ?? tabs[0]?.[0];

const me = Astro.locals.user!.id;
const flash = takeFlash(Astro.cookies);
let loadError = '';
const team = aba === 'equipe' ? await listTeam().catch((e) => ((loadError = e.message), [])) : [];
const roles = aba === 'equipe' ? await listRoles().catch(() => []) : [];
const customers = aba === 'clientes' ? await listCustomers().catch((e) => ((loadError = e.message), [])) : [];
const fmt = (d?: string | null) => (d ? new Date(d).toLocaleDateString('pt-BR') : '—');
// só o primeiro nome na lista (sem nome: a parte do e-mail antes do @)
const firstName = (m: { name: string; email: string }) => m.name.trim().split(/\s+/)[0] || m.email.split('@')[0];
const FLAG = 'whitespace-nowrap rounded-full px-2 py-0.5 text-[10px] uppercase';
// etiquetas: a própria conta só "Sua conta"; pendente não mostra "Offline"; os demais, Online/Offline
const flagsOf = (m: (typeof team)[number]) => {
  const f: { label: string; cls: string; title?: string }[] = [];
  if (m.id === me) return [{ label: 'Sua conta', cls: 'bg-agua-wash text-agua-dark' }];
  if (m.pending) f.push({ label: 'Usuário pendente', cls: 'bg-amber-50 text-amber-800', title: 'Nunca entrou ou ainda está com a senha temporária' });
  if (m.email_failed) f.push({ label: 'E-mail não enviado', cls: 'bg-red-50 text-red-700', title: 'O e-mail automático (boas-vindas ou troca de e-mail) não pôde ser enviado. Confira o endereço.' });
  if (isOnline(m)) f.push({ label: 'Online', cls: 'bg-green-50 text-green-800' });
  else if (!m.pending) f.push({ label: 'Offline', cls: 'bg-bone-200 text-ink-muted' });
  return f;
};
// células: texto à esquerda com folga; o e-mail fica mais apertado
const TH = 'whitespace-nowrap px-4 py-3 text-center lg:px-6';
const TD = 'px-4 py-3 lg:px-6';
// coluna Ativo: chave liga/desliga (mesmo visual dos toggles das telas de cadastro)
const TOGGLE = "relative inline-block h-6 w-11 shrink-0 rounded-full align-middle transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform after:content-['']";
const TOGGLE_ON = 'bg-agua-dark after:translate-x-5';
const TOGGLE_OFF = 'bg-ink/25';
const rows = aba === 'equipe' ? team.length : customers.length;
// botão Ativo: só Administradores, nunca na própria conta nem no Proprietário (que não fica inativo)
const ownerEmail = aba === 'equipe' ? await getOwnerEmail() : null;
const viewerIsProprietor = !!ownerEmail && (Astro.locals.user?.email ?? '').toLowerCase() === ownerEmail;
// pode mexer neste membro? Administradores mexem na equipe; em outro Administrador, só o Proprietário;
// ninguém mexe na própria conta (Meu perfil) nem no Proprietário
const canManageMember = (m: (typeof team)[number]) =>
  access.isOwner && m.id !== me && m.email.toLowerCase() !== ownerEmail && (!m.is_owner || viewerIsProprietor);
// Ativo: só Administradores (mesmas travas de cima)
const canToggle = canManageMember;
// Editar: Administradores (regras acima) ou "Criar/editar usuários" em quem não é Administrador
const canEditMember = (m: (typeof team)[number]) =>
  canManageMember(m) || (!access.isOwner && canManageTeam && m.id !== me && !m.is_owner);
// data curta das colunas Cadastro / Último acesso
const shortDate = (d: string) => new Date(d).toLocaleDateString('pt-BR');
const noun = aba === 'equipe' ? ['membro', 'membros'] : ['cliente', 'clientes'];
// filtros como em Compras: Cargo (só Equipe) e Status (as duas abas)
const STATUS: [string, string][] = [['ativo', 'Ativo'], ['inativo', 'Inativo']];
const filterSections = [
  ...(aba === 'equipe' ? [{ key: 'role', title: 'Cargo', options: [...roles.map((r) => [r.id, r.name] as [string, string]), ['none', 'Sem cargo'] as [string, string]] }] : []),
  { key: 'status', title: 'Status', options: STATUS },
];
const statusClass = { ativo: 'bg-agua-wash text-agua-dark', desativado: 'bg-bone-200 text-ink-muted', bloqueado: 'bg-red-50 text-red-700' };
---

<AdminLayout title="Usuários">
  <div class="flex items-center justify-between gap-3">
    <p id="user-count" class="font-sans text-sm text-ink-muted">{rows} {rows === 1 ? noun[0] : noun[1]}</p>
    {/* criar só na Equipe (cliente se cadastra pela loja); na aba Clientes fica visível, apagado */}
    {aba === 'equipe' && canManageTeam ? (
      <a href="/admin/usuarios/equipe/novo" class="btn-primary">Criar usuário</a>
    ) : (
      <span class="btn-primary pointer-events-none opacity-40" aria-disabled="true" title={aba === 'clientes' ? 'Clientes se cadastram pela loja' : 'Seu cargo não permite criar usuários'}>Criar usuário</span>
    )}
  </div>

  {flash && (
    <p role="status" class:list={['mt-4 rounded-card border px-3 py-2 text-sm', flash.type === 'ok' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-300 bg-red-50 text-red-800']}>
      {flash.text}
    </p>
  )}
  {loadError && <p class="mt-4 rounded-card border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">Não foi possível carregar: {loadError}</p>}

  {/* filtro (como em Compras) e pesquisa, acima das abas */}
  <div class="mt-4">
    <ListFilter client:load sections={filterSections} onApply="__applyUserFilters" emptyLabel={aba === 'equipe' ? 'Toda a equipe' : 'Todos os clientes'} />
  </div>
  <div class="mt-4 rounded-card border border-ink/10 bg-white p-4">
    <h2 class="mb-3 font-display text-lg">Pesquisar usuário</h2>
    {/* Clientes: sem rótulo, a busca vale para nome, CPF, e-mail e telefone */}
    {aba === 'equipe' ? <label class="label" for="user-search">Nome ou Email</label> : <label class="sr-only" for="user-search">Pesquisar cliente</label>}
    <span class="relative block">
      <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input id="user-search" class="field pl-11" type="search" placeholder={aba === 'clientes' ? 'Pesquise por nome, CPF, e-mail ou telefone…' : 'Pesquise pelo nome ou e-mail…'} autocomplete="off" />
    </span>
  </div>

  <nav class="mb-4 mt-6 flex gap-1 border-b border-ink/10" aria-label="Abas">
    {tabs.map(([key, label]) => (
      <a
        href={`/admin/usuarios?aba=${key}`}
        aria-current={aba === key ? 'page' : undefined}
        class:list={['-mb-px border-b-2 px-4 py-2 font-sans text-sm', aba === key ? 'border-ink font-semibold text-ink' : 'border-transparent text-ink-muted hover:text-ink']}
      >
        {label}
      </a>
    ))}
  </nav>

  {aba === 'equipe' && (
    <div data-table class="data-table-box rounded-card border border-ink/10 bg-white">
      {/* largura pelo conteúdo: colunas curtas com w-px + nowrap, o e-mail fica com o resto */}
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink/10 text-[11px] uppercase tracking-[0.1em] text-ink-muted">
          <tr>
            <th class:list={[TH, 'w-px']} data-sort="text">Usuário</th>
            <th class="hidden whitespace-nowrap px-2 py-3 text-center md:table-cell">E-mail</th>
            <th class:list={[TH, 'hidden w-px sm:table-cell']} data-sort="text">Cargo</th>
            <th class:list={[TH, 'w-px']} data-sort="text">Ativo</th>
            <th class:list={[TH, 'hidden w-px sm:table-cell']}>Situação</th>
            <th class:list={[TH, 'w-px']}><span class="sr-only">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          {team.map((m) => (
            <tr class="user-row border-t border-ink/10 hover:bg-bone-50" data-name={`${m.name} ${m.email}`} data-role={m.role_id ?? 'none'} data-status={m.is_active ? 'ativo' : 'inativo'}>
              <td class:list={[TD, 'whitespace-nowrap']} data-sort={m.name || m.email}>
                <span class="block font-medium">{firstName(m)}</span>
                {/* celular: cargo e situação embaixo do nome (as colunas somem) */}
                <span class="block text-[12px] text-ink-muted sm:hidden">{m.role_name}</span>
                <span class="mt-1 flex flex-wrap gap-1 sm:hidden">
                  {flagsOf(m).map((f) => <span class:list={[FLAG, f.cls]} title={f.title}>{f.label}</span>)}
                </span>
              </td>
              <td class="hidden max-w-0 px-2 py-3 md:table-cell">
                <span class="block truncate text-ink-soft" title={m.email}>{m.email}</span>
              </td>
              <td class:list={[TD, 'hidden whitespace-nowrap sm:table-cell']} data-sort={m.role_name}>
                <span class:list={['rounded-full px-2 py-0.5 text-[11px] uppercase', m.is_owner ? 'bg-blush-light text-blush' : m.role_id ? 'bg-bone-200 text-ink-soft' : 'bg-red-50 text-red-700']}>{m.role_name}</span>
              </td>
              <td class:list={[TD, 'text-center']} data-sort={m.is_active ? 'ativo' : 'inativo'}>
                {/* chave ativo/inativo; só Administradores clicam para trocar (não na própria conta nem no Proprietário) */}
                {canToggle(m) ? (
                  <form method="POST" action="/api/admin/users" class="inline" data-confirm={`Deseja ${m.is_active ? 'desativar' : 'ativar'} usuário?|${m.name || m.email} ${m.is_active ? 'fica sem acesso ao painel' : 'volta a entrar no painel com o acesso do cargo'}.|Sim|Não|primary`}>
                    <input type="hidden" name="acao" value="ativo" />
                    <input type="hidden" name="id" value={m.id} />
                    <input type="hidden" name="ativo" value={m.is_active ? '0' : '1'} />
                    <button class:list={[TOGGLE, m.is_active ? TOGGLE_ON : TOGGLE_OFF]} role="switch" aria-checked={m.is_active ? 'true' : 'false'} aria-label={m.is_active ? 'Ativo — clique para desativar' : 'Inativo — clique para ativar'} title={m.is_active ? 'Ativo' : 'Inativo'}></button>
                  </form>
                ) : (
                  <span class:list={[TOGGLE, m.is_active ? TOGGLE_ON : TOGGLE_OFF, 'cursor-not-allowed opacity-50']} role="switch" aria-checked={m.is_active ? 'true' : 'false'} aria-disabled="true" aria-label={m.is_active ? 'Ativo' : 'Inativo'} title={m.is_active ? 'Ativo' : 'Inativo'}></span>
                )}
              </td>
              <td class:list={[TD, 'hidden sm:table-cell']}>
                {/* situação: Sua conta · Usuário pendente · E-mail não enviado · Online/Offline (centralizadas) */}
                <span class="flex justify-center gap-1 whitespace-nowrap">
                  {flagsOf(m).map((f) => <span class:list={[FLAG, f.cls]} title={f.title}>{f.label}</span>)}
                </span>
              </td>
              <td class:list={[TD, 'whitespace-nowrap text-right']}>
                {/* a própria conta edita em Meu perfil; sem permissão, botão desativado */}
                {m.id === me ? (
                  <a href="/admin/perfil?de=usuarios" class="rounded-card border border-ink/20 px-2 py-1 text-[12px] hover:bg-bone-100 sm:px-3 sm:text-[13px]">Editar</a>
                ) : canEditMember(m) ? (
                  <a href={`/admin/usuarios/equipe/${m.id}`} class="rounded-card border border-ink/20 px-2 py-1 text-[12px] hover:bg-bone-100 sm:px-3 sm:text-[13px]">Editar</a>
                ) : (
                  <span class="cursor-not-allowed rounded-card border border-ink/20 px-2 py-1 text-[12px] opacity-40 sm:px-3 sm:text-[13px]" aria-disabled="true" title="Seu cargo não permite editar a equipe">Editar</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {!team.length && !loadError && <p class="p-4 text-sm text-ink-muted">Ninguém na equipe ainda.</p>}
      <p id="no-results" class="hidden p-4 text-sm text-ink-muted">Nenhum usuário com esses filtros.</p>
    </div>
  )}

  {aba === 'clientes' && (
    <div data-table class="data-table-box rounded-card border border-ink/10 bg-white">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-ink/10 text-[11px] uppercase tracking-[0.1em] text-ink-muted">
          <tr>
            <th class:list={[TH, 'w-px']} data-sort="text">Usuário</th>
            <th class:list={[TH, 'hidden w-px md:table-cell']}>CPF</th>
            <th class="hidden whitespace-nowrap px-2 py-3 text-center sm:table-cell" data-sort="text">E-mail</th>
            <th class:list={[TH, 'hidden w-px lg:table-cell']}>Telefone</th>
            <th class:list={[TH, 'hidden w-px xl:table-cell']} data-sort="date">Cadastro</th>
            <th class:list={[TH, 'hidden w-px xl:table-cell']} data-sort="date">Último acesso</th>
            <th class:list={[TH, 'w-px']} data-sort="text">Conta</th>
            <th class="w-px px-3 py-3"><span class="sr-only">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          {customers.map((c) => (
            <tr
              class="user-row border-t border-ink/10 hover:bg-bone-50"
              data-name={`${c.name} ${c.email} ${c.cpf} ${formatCpf(c.cpf)} ${c.phone} ${formatPhone(c.phone)} ${c.phone.replace(/\D/g, '')}`}
              data-status={c.status === 'ativo' ? 'ativo' : 'inativo'}
            >
              <td class="whitespace-nowrap px-3 py-3" data-sort={c.name || c.email}>
                <span class="block font-medium">{c.name || '—'}</span>
                {/* celular: e-mail embaixo (a coluna some) */}
                <span class="block max-w-[11rem] truncate text-[12px] text-ink-muted sm:hidden">{c.email}</span>
              </td>
              {/* clientes: CPF, e-mail, telefone e Visualizar centralizados; Usuário e Conta à esquerda */}
              <td class="hidden whitespace-nowrap px-3 py-3 text-center text-ink-soft md:table-cell">{c.cpf ? formatCpf(c.cpf) : '—'}</td>
              <td class="hidden max-w-0 px-3 py-3 text-center sm:table-cell" data-sort={c.email}><span class="block truncate text-ink-soft" title={c.email}>{c.email}</span></td>
              <td class="hidden whitespace-nowrap px-3 py-3 text-center text-ink-soft lg:table-cell">{c.phone ? formatPhone(c.phone) : '—'}</td>
              <td class="hidden whitespace-nowrap px-3 py-3 text-center text-ink-soft xl:table-cell" data-sort={c.created_at}>{shortDate(c.created_at)}</td>
              <td class="hidden whitespace-nowrap px-3 py-3 text-center text-ink-soft xl:table-cell" data-sort={c.last_sign_in_at ?? ''}>{c.last_sign_in_at ? shortDate(c.last_sign_in_at) : 'nunca'}</td>
              <td class="whitespace-nowrap px-3 py-3" data-sort={CUSTOMER_STATUS_LABELS[c.status]}><span class:list={['rounded-full px-2 py-0.5 text-[11px] uppercase', statusClass[c.status]]}>{CUSTOMER_STATUS_LABELS[c.status]}</span></td>
              <td class="whitespace-nowrap px-3 py-3 text-center">
                <a href={`/admin/usuarios/clientes/${c.id}`} class="rounded-card border border-ink/20 px-2 py-1 text-[12px] hover:bg-bone-100 sm:px-3 sm:text-[13px]">Visualizar</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {!customers.length && !loadError && <p class="p-4 text-sm text-ink-muted">Nenhum cliente cadastrado ainda.</p>}
      <p id="no-results" class="hidden p-4 text-sm text-ink-muted">Nenhum cliente com esses filtros.</p>
    </div>
  )}
</AdminLayout>

<script define:vars={{ noun }}>
  window.__userNoun = noun;
</script>

<script>
  import { enableListSearch } from '../../../lib/list-search';
  import { enableConfirmForms } from '../../../lib/confirm-forms';
  enableConfirmForms();
  // filtros aplicados no pop-up (ListFilter chama __applyUserFilters); vazio = todos
  let applied: Record<string, string[]> = {};
  const run = enableListSearch({
    input: 'user-search',
    rows: 'tr.user-row',
    count: 'user-count',
    noResults: 'no-results',
    noun: (window as any).__userNoun,
    extra: (row) =>
      (!applied.role?.length || applied.role.includes(row.dataset.role ?? '')) &&
      (!applied.status?.length || applied.status.includes(row.dataset.status ?? '')),
  });
  (window as any).__applyUserFilters = (a: Record<string, string[]>) => {
    applied = a;
    run();
  };
</script>
