---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listRoles } from '../../../lib/repo/roles';
import { takeFlash } from '../../../lib/flash';

export const prerender = false;

const flash = takeFlash(Astro.cookies);
let loadError = '';
const roles = await listRoles().catch((e) => ((loadError = e.message), []));
const people = (n: number) => `${n} ${n === 1 ? 'pessoa' : 'pessoas'}`;
---

<AdminLayout title="Cargos">
  <div class="flex items-center justify-between gap-3">
    <p class="font-sans text-sm text-ink-muted">{roles.length} {roles.length === 1 ? 'cargo' : 'cargos'}</p>
    <a href="/admin/cargos/novo" class="btn-primary">Criar Cargo</a>
  </div>

  {flash && (
    <p role="status" class:list={['mt-4 rounded-card border px-3 py-2 text-sm', flash.type === 'ok' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-300 bg-red-50 text-red-800']}>{flash.text}</p>
  )}
  {loadError && <p class="mt-4 rounded-card border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">Não foi possível carregar ({loadError}).</p>}

  <div class="mt-6 rounded-card border border-ink/10 bg-white">
    <table class="w-full table-fixed text-left text-sm">
      <thead class="border-b border-ink/10 text-[11px] uppercase tracking-[0.1em] text-ink-muted">
        <tr>
          <th class="w-24 px-3 py-3"><span class="sr-only">Ações</span></th>
          <th class="px-3 py-3">Nome</th>
        </tr>
      </thead>
      <tbody>
        {roles.map((r) => (
          <tr class="border-t border-ink/10 hover:bg-bone-50">
            <td class="px-3 py-3">
              {r.is_owner ? (
                <span class="text-[13px] text-ink-muted" title="O cargo Dono tem acesso total e não pode ser alterado">🔒</span>
              ) : (
                <a href={`/admin/cargos/${r.id}`} class="rounded-card border border-ink/20 px-3 py-1 text-[13px] hover:bg-bone-100">Editar</a>
              )}
            </td>
            <td class="px-3 py-3">
              <span class="block truncate font-medium">{r.name}</span>
              <span class="block truncate text-[12px] text-ink-muted">
                {r.is_owner
                  ? `Acesso total, inclusive Permissões e Cargos · ${people(r.members)}`
                  : `${r.permission_ids.length} ${r.permission_ids.length === 1 ? 'permissão' : 'permissões'} · ${people(r.members)}`}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    {!roles.length && !loadError && <p class="p-4 text-sm text-ink-muted">Nenhum cargo ainda.</p>}
  </div>
</AdminLayout>
