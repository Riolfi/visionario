---
import PasswordInput from '../components/PasswordInput.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { safeNextPath } from '../lib/auth';

export const prerender = false;

// já logado: mostra o formulário mesmo assim (entrar com outra conta encerra esta)
const current = Astro.locals.user?.email ?? null;

const next = safeNextPath(Astro.url.searchParams.get('next'), '/');
const erro = Astro.url.searchParams.get('erro');
const senhaNova = Astro.url.searchParams.get('ok') === 'senha';
const nextQs = `next=${encodeURIComponent(next)}`;
---

<BaseLayout title="Entrar" description="Acesse sua conta para acompanhar seus pedidos." noindex>
  <section class="container-x flex justify-center py-16 md:py-24">
    <div class="w-full max-w-sm">
      <p class="eyebrow">Minha conta</p>
      <h1 class="mt-3 font-display text-3xl">Entrar</h1>

      {current && (
        <p class="mt-5 rounded-card border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800">
          Você está conectado como <strong>{current}</strong>. Ao entrar com outra conta, esta sessão será encerrada.
        </p>
      )}
      {senhaNova && (
        <p class="mt-5 rounded-card border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">Senha nova salva. Entre com ela.</p>
      )}
      {erro && (
        <p class="mt-5 rounded-card border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">
          {erro === 'callback'
            ? 'Não conseguimos concluir o login. Tente de novo.'
            : erro === 'conta'
              ? 'Esta conta está desativada ou bloqueada. Fale com a loja para saber mais.'
              : erro === 'inativo'
                ? 'Esse login não está ativo, fale com um administrador.'
              : erro === 'expirou'
                ? 'Sua sessão expirou (2 horas sem uso ou 4 horas logado). Entre de novo.'
              : 'E-mail ou senha incorretos.'}
        </p>
      )}

      <a
        href={`/api/auth/google?${nextQs}`}
        class="btn-outline mt-6 w-full"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.35 11.1H12v3.83h5.35c-.23 1.4-1.62 4.1-5.35 4.1-3.22 0-5.85-2.66-5.85-5.94S8.78 7.15 12 7.15c1.83 0 3.06.78 3.76 1.45l2.57-2.48C16.7 4.6 14.6 3.7 12 3.7 6.9 3.7 2.8 7.8 2.8 12.9S6.9 22.1 12 22.1c5.9 0 9.8-4.15 9.8-9.99 0-.67-.07-1.18-.16-1.7Z"/></svg>
        Entrar com Google
      </a>

      <div class="my-5 flex items-center gap-3 text-[12px] uppercase tracking-[0.12em] text-ink-muted">
        <span class="h-px flex-1 bg-ink/10"></span>ou<span class="h-px flex-1 bg-ink/10"></span>
      </div>

      <form method="POST" action="/api/auth/login" class="space-y-4">
        <input type="hidden" name="next" value={next} />
        <div>
          <label class="label" for="email">E-mail</label>
          <input id="email" name="email" type="email" class="field" required autocomplete="email" autofocus />
        </div>
        <div>
          <label class="label" for="password">Senha</label>
          <PasswordInput id="password" name="password" required autocomplete="current-password" />
          <a href="/esqueci-senha" class="mt-1.5 inline-block font-sans text-[13px] text-ink-muted underline">Esqueci minha senha</a>
        </div>
        <button type="submit" class="btn-primary w-full">Entrar</button>
      </form>

      <p class="mt-6 text-center font-sans text-[13px] text-ink-muted">
        Não tem conta?
        <a href={`/cadastrar?${nextQs}`} class="link-underline text-ink">Criar conta</a>
      </p>
    </div>
  </section>
</BaseLayout>
