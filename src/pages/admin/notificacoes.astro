---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listNotifications, markAllNotificationsRead } from '../../lib/repo/notifications';

export const prerender = false;

const items = await listNotifications();
// abriu a tela = viu: marca tudo como lido (as não lidas seguem destacadas agora)
await markAllNotificationsRead();
const fmt = (d: string) => new Date(d).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
const ICON: Record<string, string> = {
  estoque_esgotado: '📦',
  pagamento_sem_estoque: '⚠️',
  pagamento_pedido_cancelado: '⚠️',
};
---

<AdminLayout title="Notificações">
  {items.length === 0 ? (
    <p class="rounded-card border border-ink/10 bg-white p-6 text-center text-sm text-ink-muted">Nenhuma notificação por enquanto.</p>
  ) : (
    <ul class="max-w-3xl divide-y divide-ink/10 rounded-card border border-ink/10 bg-white">
      {items.map((n) => (
        <li class:list={['flex gap-3 p-4', !n.read_at && 'bg-blush-light/40']}>
          <span class="text-lg leading-none" aria-hidden="true">{ICON[n.kind] ?? '🔔'}</span>
          <div class="min-w-0 flex-1">
            <p class="text-sm text-ink">{n.message}</p>
            <p class="mt-1 text-[12px] text-ink-muted">
              {fmt(n.created_at)}
              {!n.read_at && <span class="ml-2 rounded-full bg-red-600 px-1.5 py-0.5 text-[10px] font-semibold uppercase text-white">nova</span>}
            </p>
            <p class="mt-1 text-[12px]">
              {n.product_id && <a href={`/admin/produtos/${n.product_id}`} class="text-agua-dark underline">Abrir produto</a>}
              {n.order_number && <a href={`/admin/pedidos/${n.order_number}`} class="text-agua-dark underline">Abrir pedido</a>}
            </p>
          </div>
        </li>
      ))}
    </ul>
  )}
</AdminLayout>
