---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { RULES } from '../../lib/rbac';
import { supabaseAdmin } from '../../lib/supabase';

export const prerender = false;

const user = Astro.locals.user!;
const access = Astro.locals.admin!;
const sb = supabaseAdmin();
const { data: profile } = sb
  ? await sb.from('profiles').select('full_name, phone').eq('id', user.id).maybeSingle()
  : { data: null };

const OK: Record<string, string> = {
  dados: 'Dados salvos.',
  email: 'E-mail alterado. Use o novo e-mail no próximo login.',
  'codigo-email': 'Enviamos um código de 6 dígitos para o seu e-mail atual. Digite-o abaixo para concluir a troca.',
  senha: 'Senha alterada.',
};
const ERRO: Record<string, string> = {
  nome: 'Informe o nome (mínimo 2 letras).',
  email: 'E-mail inválido.',
  'mesmo-email': 'Esse já é o seu e-mail.',
  proprietario: 'Você é o Proprietário da conta: passe o Proprietário para outro Administrador (em Usuários) antes de mudar o seu e-mail.',
  'sem-envio': 'O envio de e-mail não está configurado na loja, então o código não pode ser enviado.',
  migration: 'Falta rodar a migration 0021_email_codes.sql no Supabase.',
  envio: 'Não foi possível enviar o código. Tente de novo.',
  codigo: 'Código incorreto.',
  'codigo-expirou': 'O código expirou. Peça outro.',
  'codigo-novo': 'Peça um novo código.',
  'email-em-uso': 'Esse e-mail já é usado por outra conta.',
  'senha-atual': 'Senha atual incorreta.',
  'senha-curta': 'A nova senha precisa ter pelo menos 8 caracteres.',
  'senha-diferente': 'A confirmação não bate com a nova senha.',
  falha: 'Não foi possível salvar. Tente de novo.',
};
const ok = OK[Astro.url.searchParams.get('ok') ?? ''];
// depois de pedir a troca de e-mail (ou errar o código), mostra o campo do código
const askCode = ['codigo-email'].includes(Astro.url.searchParams.get('ok') ?? '') || ['codigo', 'codigo-expirou'].includes(Astro.url.searchParams.get('erro') ?? '');
const erro = ERRO[Astro.url.searchParams.get('erro') ?? ''];
const fmt = (d?: string | null) => (d ? new Date(d).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) : '—');
const allowed = access.isOwner ? null : RULES.filter((r) => access.rules.includes(r.key));
---

<AdminLayout title="Meu perfil">
  <div class="max-w-2xl space-y-6">
    {ok && <p role="status" class="rounded-card border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">{ok}</p>}
    {erro && <p role="alert" class="rounded-card border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">{erro}</p>}

    <section class="rounded-card border border-ink/10 bg-white p-5">
      <h2 class="font-display text-lg">Conta</h2>
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 font-sans text-sm">
        <dt class="text-ink-muted">E-mail</dt><dd class="break-all">{user.email}</dd>
        <dt class="text-ink-muted">Cargo</dt><dd>{access.roleName}</dd>
        <dt class="text-ink-muted">Pode</dt>
        <dd>
          {allowed === null
            ? 'Tudo, inclusive Permissões e Cargos'
            : allowed.length
              ? <ul class="list-inside list-disc">{allowed.map((r) => <li>{r.label}</li>)}</ul>
              : 'Nada ainda — peça a um Administrador para definir o seu cargo'}
        </dd>
        <dt class="text-ink-muted">Criada em</dt><dd>{fmt(user.created_at)}</dd>
        <dt class="text-ink-muted">Último login</dt><dd>{fmt(user.last_sign_in_at)}</dd>
      </dl>
    </section>

    <form method="POST" action="/api/admin/profile" class="space-y-4 rounded-card border border-ink/10 bg-white p-5">
      <h2 class="font-display text-lg">Dados pessoais</h2>
      <input type="hidden" name="acao" value="dados" />
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block"><span class="label">Nome</span><input class="field" name="full_name" value={profile?.full_name ?? ''} required minlength="2" autocomplete="name" /></label>
        <label class="block"><span class="label">Telefone</span><input class="field" name="phone" value={profile?.phone ?? ''} inputmode="tel" autocomplete="tel" /></label>
      </div>
      <button class="btn-primary">Salvar dados</button>
    </form>

    <form method="POST" action="/api/admin/profile" class="space-y-4 rounded-card border border-ink/10 bg-white p-5">
      <h2 class="font-display text-lg">Trocar e-mail</h2>
      <input type="hidden" name="acao" value="email" />
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block"><span class="label">Novo e-mail</span><input class="field" type="email" name="email" required autocomplete="email" /></label>
        <label class="block"><span class="label">Senha atual</span><input class="field" type="password" name="senha_atual" required autocomplete="current-password" /></label>
      </div>
      <p class="text-[12px] text-ink-muted">Para confirmar, enviamos um código ao seu e-mail atual.</p>
      <button class="btn-primary">Trocar e-mail</button>
    </form>

    {askCode && (
      <form method="POST" action="/api/admin/profile" class="space-y-4 rounded-card border border-agua/40 bg-white p-5">
        <h2 class="font-display text-lg">Confirmar troca de e-mail</h2>
        <input type="hidden" name="acao" value="email-codigo" />
        <label class="block max-w-xs">
          <span class="label">Código de 6 dígitos</span>
          <input class="field text-center text-xl tracking-[0.4em]" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required autofocus />
        </label>
        <p class="text-[12px] text-ink-muted">O código vale por 15 minutos. Não recebeu? Peça de novo no formulário acima.</p>
        <button class="btn-primary">Confirmar</button>
      </form>
    )}

    <form method="POST" action="/api/admin/profile" class="space-y-4 rounded-card border border-ink/10 bg-white p-5">
      <h2 class="font-display text-lg">Trocar senha</h2>
      <input type="hidden" name="acao" value="senha" />
      <div class="grid gap-4 sm:grid-cols-3">
        <label class="block"><span class="label">Senha atual</span><input class="field" type="password" name="senha_atual" required autocomplete="current-password" /></label>
        <label class="block"><span class="label">Nova senha</span><input class="field" type="password" name="nova" required minlength="8" autocomplete="new-password" /></label>
        <label class="block"><span class="label">Confirmar nova senha</span><input class="field" type="password" name="confirmar" required minlength="8" autocomplete="new-password" /></label>
      </div>
      <p class="text-[12px] text-ink-muted">Mínimo de 8 caracteres.</p>
      <button class="btn-primary">Trocar senha</button>
    </form>

    <form method="POST" action="/api/admin/profile" class="rounded-card border border-ink/10 bg-white p-5" data-confirm="Sair de todos os aparelhos?|Você vai precisar entrar de novo em todos eles, inclusive neste.|Sair de todos">
      <h2 class="font-display text-lg">Sessões</h2>
      <p class="mt-1 text-sm text-ink-soft">Perdeu um aparelho ou entrou num computador que não é seu? Encerre todas as sessões.</p>
      <input type="hidden" name="acao" value="sair-todos" />
      <button class="btn-outline mt-4">Sair de todos os aparelhos</button>
    </form>
  </div>
</AdminLayout>

<script>
  import { enableConfirmForms } from '../../lib/confirm-forms';
  enableConfirmForms();
</script>
