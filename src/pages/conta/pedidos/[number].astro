---
import { orderLabel } from '../../../lib/format';
import AccountLayout from '../../../layouts/AccountLayout.astro';
import { getUserOrder } from '../../../lib/repo/orders';
import { brl } from '../../../lib/format';
import { ORDER_STATUS_LABELS } from '../../../lib/types';
import { CUSTOMER_CANCELABLE, CUSTOMER_CANCEL_REASONS, RETURN_REASONS, returnDeadline } from '../../../lib/order-policy';

export const prerender = false;

const user = Astro.locals.user!;
const { number } = Astro.params;
const order = number ? await getUserOrder(user.id, number) : null;
if (!order) return Astro.redirect('/conta/pedidos');

const a = order.shipping_address;
// cancelar: o próprio cliente, até ser enviado (estorno automático se já pagou)
const canCancel = CUSTOMER_CANCELABLE.includes(order.status);
const afterShipping = order.status === 'shipped' || order.status === 'delivered';
// devolução: até 7 dias corridos depois da entrega (CDC)
const deadline = returnDeadline(order);
const canReturn = !!deadline && Date.now() <= deadline.getTime() && !order.return_requested_at;
const fmtDay = (d: Date | string) => new Date(d).toLocaleDateString('pt-BR');
const MSG: Record<string, [string, string]> = {
  'cancelamento=ok': ['ok', 'Pedido cancelado. Nenhum valor foi cobrado.'],
  'cancelamento=estornado': ['ok', 'Pedido cancelado e valor estornado para o mesmo meio de pagamento. Enviamos os detalhes por e-mail.'],
  'cancelamento=fora': ['erro', 'Este pedido já foi enviado e não pode mais ser cancelado.'],
  'cancelamento=motivo': ['erro', 'Escolha o motivo do cancelamento.'],
  'cancelamento=falha': ['erro', 'Não foi possível cancelar agora. Tente de novo ou fale com a loja.'],
  'devolucao=ok': ['ok', 'Pedido de devolução enviado. A loja entra em contato para combinar a coleta e o reembolso.'],
  'devolucao=ja': ['erro', 'A devolução deste pedido já foi solicitada.'],
  'devolucao=prazo': ['erro', 'O prazo de 7 dias para pedir a devolução já passou. Fale com a loja.'],
  'devolucao=motivo': ['erro', 'Escolha o motivo da devolução.'],
  'devolucao=falha': ['erro', 'Não foi possível enviar agora. Tente de novo.'],
};
const q = Astro.url.searchParams;
const msg = MSG[q.has('cancelamento') ? `cancelamento=${q.get('cancelamento')}` : `devolucao=${q.get('devolucao')}`];
---

<AccountLayout title={`Pedido ${orderLabel(order.order_number)}`} active="pedidos">
  <a href="/conta/pedidos" class="font-sans text-[12px] uppercase tracking-[0.12em] text-ink-muted hover:text-ink">← Meus pedidos</a>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <span class="rounded-full bg-agua-wash px-3 py-1 font-sans text-[12px] uppercase tracking-[0.1em] text-agua-dark">
      {ORDER_STATUS_LABELS[order.status]}
    </span>
    <span class="font-sans text-[13px] text-ink-muted">
      {new Date(order.created_at).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
    </span>
  </div>

  {msg && (
    <p class:list={['mt-4 rounded-card border px-3 py-2 text-sm', msg[0] === 'ok' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-300 bg-red-50 text-red-800']}>{msg[1]}</p>
  )}
  {order.return_requested_at && (
    <p class="mt-4 rounded-card border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800">
      Devolução solicitada em {fmtDay(order.return_requested_at)}. A loja entra em contato para combinar a coleta e o reembolso.
    </p>
  )}

  {order.tracking_code && (
    <div class="mt-4 rounded-card border border-agua/40 bg-agua-wash px-4 py-3 text-[14px] text-ink-soft">
      <span class="font-medium text-agua-dark">Código de rastreio:</span> {order.tracking_code}
    </div>
  )}

  <div class="mt-6 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
    <section class="rounded-card border border-ink/10 bg-white/50 p-5">
      <h2 class="font-display text-lg">Itens</h2>
      <ul class="mt-3 divide-y divide-ink/10">
        {order.items.map((i) => (
          <li class="flex items-center justify-between py-3 text-[14px]">
            <span class="text-ink">{i.product_name} <span class="text-ink-muted">× {i.quantity}</span></span>
            <span>{brl(i.unit_price_cents * i.quantity)}</span>
          </li>
        ))}
      </ul>
      <dl class="mt-4 space-y-1.5 border-t border-ink/10 pt-3 text-[14px] text-ink-soft">
        <div class="flex justify-between"><dt>Subtotal</dt><dd>{brl(order.subtotal_cents)}</dd></div>
        <div class="flex justify-between"><dt>Frete</dt><dd>{order.shipping_cents === 0 ? 'Grátis' : brl(order.shipping_cents)}</dd></div>
        <div class="flex justify-between border-t border-ink/10 pt-2 font-display text-lg text-ink"><dt>Total</dt><dd>{brl(order.total_cents)}</dd></div>
      </dl>
    </section>

    <section class="rounded-card border border-ink/10 bg-white/50 p-5 text-[14px] text-ink-soft">
      <h2 class="font-display text-lg text-ink">Entrega</h2>
      <p class="mt-2">
        {a.street}, {a.number}{a.complement ? ` — ${a.complement}` : ''}<br />
        {a.district} — {a.city}/{a.state}<br />
        CEP {a.cep}
      </p>
      <p class="mt-4 text-[12px] text-ink-muted">Pagamento: {order.payment_method ?? '—'}</p>
    </section>
  </div>

  {canCancel && (
    <details class="mt-6 rounded-card border border-ink/10 bg-white/50 p-5 text-sm">
      <summary class="cursor-pointer font-medium text-red-700">Cancelar pedido</summary>
      <form method="POST" action="/api/account/cancelar-pedido" class="mt-4 max-w-md space-y-3" data-confirm="Cancelar este pedido?|Não dá para desfazer. Se você já pagou, o valor é estornado para o mesmo meio de pagamento.|Cancelar pedido|Voltar">
        <input type="hidden" name="order_number" value={order.order_number} />
        <label class="block">
          <span class="label">Motivo <span class="text-red-600">*</span></span>
          <select name="motivo" class="field" required data-other-target="cancel-detalhe">
            <option value="" disabled selected>Selecione</option>
            {CUSTOMER_CANCEL_REASONS.map((r) => <option value={r}>{r}</option>)}
          </select>
        </label>
        <label class="block"><span class="label">Detalhes <span class="text-[11px] font-normal text-ink-muted/60">(obrigatório em "Outro")</span></span><textarea id="cancel-detalhe" name="detalhe" rows="3" maxlength="400" class="field"></textarea></label>
        <p class="text-[12px] text-ink-muted">O cancelamento é na hora. Se o pedido já foi pago, o valor é estornado automaticamente para o mesmo meio de pagamento (Pix em instantes; cartão em até 2 faturas).</p>
        <button class="rounded-card border border-red-300 px-4 py-2 text-sm text-red-700 hover:bg-red-50">Cancelar pedido</button>
      </form>
    </details>
  )}

  {afterShipping && (
    <p class="mt-6 rounded-card border border-ink/10 bg-white/50 p-4 text-sm text-ink-soft">
      Para devoluções ou recusa de entrega, entre em contato com o <a href="/contato" class="underline">suporte</a> ou consulte nossa <a href="/politica-trocas" class="underline">política de trocas</a>.
    </p>
  )}

  {canReturn && (
    <details class="mt-4 rounded-card border border-ink/10 bg-white/50 p-5 text-sm">
      <summary class="cursor-pointer font-medium">Solicitar devolução <span class="font-normal text-ink-muted">(até {fmtDay(deadline!)})</span></summary>
      <form method="POST" action="/api/account/devolucao" class="mt-4 max-w-md space-y-3">
        <input type="hidden" name="order_number" value={order.order_number} />
        <label class="block">
          <span class="label">Motivo <span class="text-red-600">*</span></span>
          <select name="motivo" class="field" required data-other-target="devolucao-detalhe">
            <option value="" disabled selected>Selecione</option>
            {RETURN_REASONS.map((r) => <option value={r}>{r}</option>)}
          </select>
        </label>
        <label class="block"><span class="label">Detalhes <span class="text-[11px] font-normal text-ink-muted/60">(obrigatório em "Outro")</span></span><textarea id="devolucao-detalhe" name="detalhe" rows="3" maxlength="400" class="field"></textarea></label>
        <p class="text-[12px] text-ink-muted">Você tem 7 dias corridos depois da entrega para devolver. A loja entra em contato para combinar a coleta; o reembolso sai quando o produto chegar.</p>
        <button class="btn-primary">Enviar pedido de devolução</button>
      </form>
    </details>
  )}
</AccountLayout>

<script>
  import { enableConfirmForms } from '../../../lib/confirm-forms';
  enableConfirmForms();
  // "Outro" exige o texto de detalhes
  document.querySelectorAll<HTMLSelectElement>('select[data-other-target]').forEach((sel) =>
    sel.addEventListener('change', () => {
      const t = document.getElementById(sel.dataset.otherTarget!) as HTMLTextAreaElement | null;
      if (t) t.required = sel.value === 'Outro';
    }),
  );
</script>
