---
import { orderLabel } from '../../../lib/format';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getOrderByNumber } from '../../../lib/repo/orders';
import { brl, formatCpf, formatPhone, orderStatusBadge, whatsappUrl } from '../../../lib/format';
import { FINAL_STATUSES, ORDER_NEXT, ORDER_STATUS_LABELS, orderStatusLabel, PAYMENT_METHOD_LABELS, RECEIVED_STATUSES, type OrderStatus } from '../../../lib/types';
import { RESERVE_MINUTES } from '../../../lib/repo/orders';
import { CANCEL_REASONS_CAIXA, CANCEL_REASONS_ONLINE, STAFF_CANCELABLE_ONLINE, returnDeadline } from '../../../lib/order-policy';

export const prerender = false;

const { number } = Astro.params;
const order = number ? await getOrderByNumber(number) : null;
if (!order) return Astro.redirect('/admin/pedidos');

const a = order.shipping_address;
const saved = Astro.url.searchParams.get('ok') === '1';
const savedEmail = Astro.url.searchParams.get('email') === '1';
const updateError = Astro.url.searchParams.get('erro') === 'update';
const motivo = Astro.url.searchParams.get('motivo');
const ERROS: Record<string, string> = {
  estoque: 'Não dá para marcar como pago: falta estoque de um dos produtos. Reponha o estoque e tente de novo.',
  rastreio: 'Para marcar como Enviado, informe o código de rastreio.',
  'rastreio-invalido': 'Código de rastreio inválido. Use o código dos Correios (ex.: AA123456789BR) ou o link de rastreio da transportadora.',
  'email-invalido': 'O e-mail do cliente é inválido. Desmarque "Enviar e-mail ao cliente" para salvar sem avisar.',
  email: 'Não foi possível enviar o e-mail ao cliente, então nada foi alterado. Confira o e-mail do cliente ou salve sem enviar o e-mail.',
  retrocesso: 'O status só avança: não dá para voltar a um status anterior.',
  final: 'Pedido entregue ou cancelado não muda mais de status.',
  igual: 'Escolha um status diferente do atual.',
};
// só os próximos status da linha do tempo (cancelar tem botão próprio); final = travado
const isFinal = FINAL_STATUSES.includes(order.status);
// rastreio visível/obrigatório de Enviado em diante
const TRACKING_STATUSES = ['shipped', 'delivered'];
const trackingOn = TRACKING_STATUSES.includes(order.status);
const COPY_ICON = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" /></svg>';
// estoque já baixou (pago ou Caixa): no cancelamento, escolher se os itens voltam
const stockOut = order.source === 'caixa' || RECEIVED_STATUSES.includes(order.status);
const statuses = [order.status, ...ORDER_NEXT[order.status]].map((s) => [s, ORDER_STATUS_LABELS[s]]) as [OrderStatus, string][];
// aguardando pagamento: estoque reservado até a hora limite (a baixa é no pagamento)
const reservedUntil = order.status === 'pending' ? new Date(new Date(order.created_at).getTime() + RESERVE_MINUTES * 60_000) : null;
import { can } from '../../../lib/rbac';
import { takeFlash } from '../../../lib/flash';
const canStatus = can(Astro.locals.admin, 'pedidos.status');
const canCancel = can(Astro.locals.admin, 'pedidos.cancelar') && order.status !== 'cancelled';
// compra online: a equipe cancela até o envio; depois disso, só devolução
const cancelBlocked = order.source !== 'caixa' && !STAFF_CANCELABLE_ONLINE.includes(order.status);
const flash = takeFlash(Astro.cookies);
import { getPersonSummary } from '../../../lib/repo/team';
const isCaixa = order.source === 'caixa';
// quem vendeu (Caixa) e quem cancelou — nome e cargo (0023)
const [operator, canceller] = await Promise.all([getPersonSummary(order.operator_id), getPersonSummary(order.cancelled_by)]);
const created = new Date(order.created_at);
const fmtDate = (d: Date) => d.toLocaleDateString('pt-BR');
const fmtTime = (d: Date) => d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
// venda sem cadastro no Caixa: "Não identificado" no lugar de "Consumidor"/vazio
const anonymous = !order.user_id && (!order.customer_name || order.customer_name === 'Consumidor');
const customerName = anonymous ? 'Não identificado' : order.customer_name || order.customer_email || 'Não identificado';
// dinheiro: recebido e troco (pagamento simples guarda o recebido; combinado, a parte em dinheiro)
const cashPart = order.payments?.find((p) => p.method === 'cash');
const received = order.payment_method === 'cash' ? order.received_cents ?? null : null;
const change = received != null ? Math.max(0, received - order.total_cents) : cashPart ? Math.max(0, (order.payments ?? []).reduce((t, p) => t + p.amount_cents, 0) - order.total_cents) : null;
const CANCEL_REASONS = order.source === 'caixa' ? CANCEL_REASONS_CAIXA : CANCEL_REASONS_ONLINE;
// quem cancelou: o próprio cliente ou alguém da equipe (nome e cargo)
const cancelledByCustomer = !!order.cancelled_by && order.cancelled_by === order.user_id;
// concluir devolução: quem pode cancelar, com a devolução pedida e ainda aberta
const canReturn = can(Astro.locals.admin, 'pedidos.cancelar') && order.status === 'delivered' && !order.return_completed_at;
---

<AdminLayout title={`Pedido ${orderLabel(order.order_number)}`}>
  <a href="/admin/pedidos" class="font-sans text-[12px] uppercase tracking-[0.12em] text-ink-muted hover:text-ink">← Pedidos</a>

  {flash && (
    <p role="status" class:list={['mt-4 rounded-card border px-3 py-2 text-sm', flash.type === 'ok' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-300 bg-red-50 text-red-800']}>{flash.text}</p>
  )}
  {saved && (
    <p role="status" class="mt-4 rounded-card border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800">
      {savedEmail ? 'Status atualizado e e-mail enviado ao cliente.' : 'Status atualizado.'}
    </p>
  )}
  {updateError && (
    <p role="alert" class="mt-4 rounded-card border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">
      {ERROS[motivo ?? ''] ?? 'Não foi possível atualizar o status. Tente de novo.'}
    </p>
  )}

  <div class="mt-4 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
    <section class="rounded-card border border-ink/10 bg-white p-5">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-lg">Itens</h2>
        <div class="flex items-center gap-2">
          {/* canal: físico (Caixa) ou digital (loja online) */}
          <span class="rounded-full bg-blush-light px-2 py-0.5 text-[11px] uppercase tracking-[0.1em] text-ink-soft">{order.source === 'caixa' ? 'Venda no caixa' : 'Venda online'}</span>
          <span class:list={['rounded-full px-2 py-0.5 text-[11px] font-medium uppercase', orderStatusBadge(order.status, order.source)]}>{orderStatusLabel(order.status, order.source)}</span>
        </div>
      </div>
      <table class="mt-4 w-full text-left text-sm">
        <tbody>
          {order.items.map((i) => (
            <tr class="border-t border-ink/10">
              <td class="py-2">
                {i.product_name}
                <span class="block text-[12px] text-ink-muted">{i.quantity}x {brl(i.unit_price_cents)}</span>
              </td>
              <td class="whitespace-nowrap py-2 text-right">
                <span class="text-[12px] text-ink-muted">Total: </span>{brl(i.unit_price_cents * i.quantity)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <dl class="mt-4 space-y-1 border-t border-ink/10 pt-3 text-sm">
        <div class="flex justify-between text-ink-soft"><dt>Subtotal</dt><dd>{brl(order.subtotal_cents)}</dd></div>
        {!isCaixa && <div class="flex justify-between text-ink-soft"><dt>Frete</dt><dd>{brl(order.shipping_cents)}</dd></div>}
        <div class="flex justify-between font-display text-lg"><dt>Total</dt><dd>{brl(order.total_cents)}</dd></div>
        {order.payment_method && (
          <div class="flex justify-between text-ink-soft"><dt>Pagamento</dt><dd>{PAYMENT_METHOD_LABELS[order.payment_method]}</dd></div>
        )}
        {/* combinado: quanto entrou em cada forma (no dinheiro, o recebido) */}
        {order.payments?.map((p) => (
          <div class="flex justify-between pl-3 text-[13px] text-ink-muted"><dt>{PAYMENT_METHOD_LABELS[p.method]}{p.method === 'cash' && ' (recebido)'}</dt><dd>{brl(p.amount_cents)}</dd></div>
        ))}
        {received != null && (
          <div class="flex justify-between pl-3 text-[13px] text-ink-muted"><dt>Valor recebido</dt><dd>{brl(received)}</dd></div>
        )}
        {change != null && (
          <div class="flex justify-between pl-3 text-[13px] text-ink-muted"><dt>Troco</dt><dd>{brl(change)}</dd></div>
        )}
      </dl>
      {order.mp_payment_id && (
        <p class="mt-3 font-sans text-[12px] text-ink-muted">Pagamento MP: {order.mp_payment_id} · método: {order.payment_method}</p>
      )}
    </section>

    <section class="space-y-4">
      {order.source === 'caixa' ? (
        <div class="rounded-card border border-ink/10 bg-white p-5">
          <h2 class="font-display text-lg">Venda presencial</h2>
          <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            <div><dt class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Operador</dt><dd class="font-medium">{operator?.name ?? '—'}</dd></div>
            <div><dt class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Cargo</dt><dd>{operator?.role ?? '—'}</dd></div>
            <div><dt class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Data</dt><dd>{fmtDate(created)}</dd></div>
            <div><dt class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Horário</dt><dd>{fmtTime(created)}</dd></div>
          </dl>
          <p class="mt-3 text-sm text-ink-soft">
            {order.status === 'cancelled'
              ? 'Venda do caixa cancelada; os itens voltaram ao estoque.'
              : 'Venda concluída e paga no caixa. Não há separação, envio ou código de rastreio para este pedido.'}
          </p>
        </div>
      ) : !canStatus || isFinal ? (
        <div class="rounded-card border border-ink/10 bg-white p-5 text-sm text-ink-soft">
          <h2 class="font-display text-lg text-ink">Status</h2>
          <p class="mt-2">{isFinal ? 'Pedido entregue ou cancelado: o status não muda mais.' : 'Seu cargo não permite mudar o status deste pedido.'}</p>
          {order.tracking_code && (
            <label class="mt-3 block">
              <span class="label">Código de rastreio</span>
              <span class="relative block">
                <input class="field pr-11" value={order.tracking_code} readonly />
                <button type="button" data-copy-field class="absolute right-2 top-1/2 grid h-8 w-8 -translate-y-1/2 place-items-center rounded-full text-ink-muted hover:text-ink" aria-label="Copiar código de rastreio" title="Copiar" set:html={COPY_ICON}></button>
              </span>
              <span data-copy-ok class="mt-1 hidden text-[12px] text-green-700" role="status">Copiado!</span>
            </label>
          )}
        </div>
      ) : (
      <form
        id="status-form"
        method="POST"
        action="/api/admin/orders"
        class="rounded-card border border-ink/10 bg-white p-5"
        data-current={order.status}
        data-email={order.customer_email ?? ''}
      >
        <h2 class="font-display text-lg">Atualizar status</h2>
        <input type="hidden" name="order_number" value={order.order_number} />
        <label class="label mt-3" for="status">Status do pedido</label>
        {/* só o atual e os próximos da linha do tempo */}
        <select id="status" name="status" class="field" data-status-select>
          {statuses.map(([value, label]) => (
            <option value={value} selected={value === order.status}>{label}</option>
          ))}
        </select>
        {reservedUntil && (
          <p class="mt-2 text-[12px] text-ink-muted">Estoque reservado até {reservedUntil.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })} de {reservedUntil.toLocaleDateString('pt-BR')}; a baixa acontece quando o pagamento é confirmado.</p>
        )}

        {/* rastreio: aparece (e é obrigatório) de Enviado em diante; depois de enviado, com copiar */}
        <div id="tracking-wrap" class:list={['mt-3', !trackingOn && 'hidden']}>
          <label class="label" for="tracking_code">Código de rastreio <span class="text-red-600">*</span></label>
          <span class="relative block">
            <input
              id="tracking_code"
              name="tracking_code"
              class:list={['field', order.tracking_code && 'pr-11']}
              value={order.tracking_code ?? ''}
              required={trackingOn}
              disabled={!trackingOn}
              autocomplete="off"
              placeholder="AA123456789BR ou link da transportadora"
            />
            {order.tracking_code && (
              <button type="button" data-copy-field class="absolute right-2 top-1/2 grid h-8 w-8 -translate-y-1/2 place-items-center rounded-full text-ink-muted hover:text-ink" aria-label="Copiar código de rastreio" title="Copiar" set:html={COPY_ICON}></button>
            )}
          </span>
          <span data-copy-ok class="mt-1 hidden text-[12px] text-green-700" role="status">Copiado!</span>
          <p id="tracking-error" class="mt-1 hidden text-[12px] text-red-700">! Use o código dos Correios (AA123456789BR) ou um link de rastreio (https://…).</p>
        </div>

        {/* lembra a última escolha de quem opera (neste navegador) */}
        <label class="mt-3 flex items-center gap-2 text-sm text-ink-soft">
          <input type="checkbox" name="notify" id="notify" data-remember-notify />
          Enviar e-mail ao cliente
        </label>

        <button type="submit" class="btn-primary mt-4 w-full">Salvar</button>
      </form>
      )}

      {canCancel && (
        <div class="rounded-card border border-red-200 bg-white p-5">
          <h2 class="font-display text-lg">Cancelar compra</h2>
          <p class="mt-2 text-sm text-ink-soft">
            {cancelBlocked
              ? 'Pedido já enviado: não dá para cancelar. Se o cliente quiser devolver, ele pede em Minha conta › Pedidos (até 7 dias depois da entrega).'
              : isCaixa
                ? 'Cancela a venda, devolve os itens ao estoque e registra a saída do valor no caixa de hoje.'
                : 'Cancela a compra, estorna o valor pelo Mercado Pago (se já foi pago), devolve os itens ao estoque e avisa o cliente.'}
          </p>
          <button type="button" id="cancel-open" disabled={cancelBlocked} class="mt-3 w-full rounded-card border border-red-300 px-4 py-2 text-sm text-red-700 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-40">Cancelar compra</button>
        </div>
      )}

      {/* devolução pedida pelo cliente (até 7 dias depois da entrega) */}
      {order.return_requested_at && (
        <div class:list={['rounded-card border bg-white p-5 text-sm', order.return_completed_at ? 'border-ink/10' : 'border-amber-300']}>
          <h2 class="font-display text-lg">{order.return_completed_at ? 'Devolução concluída' : 'Devolução solicitada'}</h2>
          <p class="mt-2 text-ink-soft">Pedida em {new Date(order.return_requested_at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' })}: {order.return_reason}</p>
          {order.return_completed_at ? (
            <p class="mt-2 text-ink-soft">Concluída em {new Date(order.return_completed_at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' })}: valor estornado e pedido cancelado.</p>
          ) : canReturn ? (
            <form method="POST" action="/api/admin/orders/devolucao" class="mt-3 space-y-3" data-confirm={`Concluir a devolução?|Confirme que o produto chegou. O valor de ${brl(order.total_cents)} é estornado ao cliente pelo Mercado Pago e o pedido fica Cancelado.|Concluir devolução|Voltar|primary`}>
              <input type="hidden" name="order_number" value={order.order_number} />
              <p class="text-[12px] text-ink-muted">Use quando o produto devolvido chegar e estiver conferido.</p>
              {/* produto com defeito não volta a ficar à venda */}
              <label class="flex items-start gap-2 text-[13px] text-ink-soft">
                <input type="checkbox" name="restock" class="mt-0.5" checked={!/defeito/i.test(order.return_reason ?? '')} />
                Devolver os itens ao estoque (desmarque se o produto voltou com defeito)
              </label>
              <button class="btn-primary w-full">Concluir devolução</button>
            </form>
          ) : (
            <p class="mt-2 text-[12px] text-ink-muted">Combine a coleta com o cliente; o reembolso sai quando o produto chegar.</p>
          )}
        </div>
      )}
      {order.status === 'delivered' && !order.return_requested_at && returnDeadline(order) && (
        <p class="text-[12px] text-ink-muted">Prazo de devolução do cliente: até {returnDeadline(order)!.toLocaleDateString('pt-BR')}.</p>
      )}

      {/* auditoria do cancelamento */}
      {order.status === 'cancelled' && (order.cancel_reason || order.cancelled_at) && (
        <div class="rounded-card border border-red-200 bg-white p-5 text-sm">
          <h2 class="font-display text-lg">Cancelamento</h2>
          <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
            <dt class="text-ink-muted">Por</dt><dd>{cancelledByCustomer ? `Cliente — ${customerName}` : canceller ? `${canceller.name} (${canceller.role}) · ${canceller.email}` : '—'}</dd>
            {isCaixa && <><dt class="text-ink-muted">Venda feita por</dt><dd>{operator ? `${operator.name} (${operator.role})` : '—'}</dd></>}
            <dt class="text-ink-muted">Quando</dt><dd>{order.cancelled_at ? new Date(order.cancelled_at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'medium' }) : '—'}</dd>
            <dt class="text-ink-muted">Motivo</dt><dd>{order.cancel_reason || '—'}</dd>
          </dl>
        </div>
      )}

      <div class="rounded-card border border-ink/10 bg-white p-5 text-sm">
        <h2 class="font-display text-lg">Cliente</h2>
        <dl class="mt-2 grid grid-cols-[auto_1fr] items-center gap-x-3 gap-y-1.5 text-ink-soft">
          <dt class="text-ink-muted">Nome:</dt>
          {/* cliente com conta: nome vira link para a ficha dele */}
          <dd>{order.user_id ? <a href={`/admin/usuarios/clientes/${order.user_id}`} class="text-agua-dark underline">{customerName}</a> : customerName}</dd>
          <dt class="text-ink-muted">Email:</dt>
          <dd class="break-all">{order.customer_email || '—'}</dd>
          <dt class="text-ink-muted">Telefone:</dt>
          <dd class="flex items-center gap-2">
            {order.customer_phone ? formatPhone(order.customer_phone) : '—'}
            {order.customer_phone && whatsappUrl(order.customer_phone) && (
              <a href={whatsappUrl(order.customer_phone)} target="_blank" rel="noopener" class="grid h-7 w-7 place-items-center rounded-full bg-[#25D366] text-white hover:brightness-95" aria-label="Conversar no WhatsApp" title="Conversar no WhatsApp">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z" /></svg>
              </a>
            )}
          </dd>
          <dt class="text-ink-muted">CPF:</dt>
          <dd>{order.customer_cpf ? formatCpf(order.customer_cpf) : '—'}</dd>
        </dl>
      </div>
      <div class="rounded-card border border-ink/10 bg-white p-5 text-sm">
        <h2 class="font-display text-lg">Entrega</h2>
        {isCaixa || !a?.street ? (
          <p class="mt-2 text-ink-soft">Retirada presencial / Balcão</p>
        ) : (
          <>
            <p class="mt-2 text-ink-soft">
              {a.street}, {a.number}{a.complement ? ` — ${a.complement}` : ''}<br />
              {a.district} — {a.city}/{a.state}<br />
              CEP {a.cep}
            </p>
            <button type="button" data-copy={`${a.street}, ${a.number}${a.complement ? ` - ${a.complement}` : ''} - ${a.district} - ${a.city}/${a.state} - CEP ${a.cep}`} class="mt-3 rounded-card border border-ink/20 px-3 py-1 text-[12px] hover:bg-bone-100">Copiar endereço</button>
          </>
        )}
      </div>
      {canCancel && (
        <dialog id="cancel-dialog" class="m-auto w-[min(92vw,28rem)] rounded-card border border-ink/10 bg-bone p-0 text-ink shadow-xl backdrop:bg-ink/50">
          <form method="POST" action="/api/admin/orders/cancel" class="space-y-4 p-6">
            <input type="hidden" name="order_number" value={order.order_number} />
            <h2 class="font-display text-xl">Cancelar a compra {orderLabel(order.order_number)}?</h2>
            <p class="text-sm text-ink-soft">
              O valor sai dos totais recebidos.
              {RECEIVED_STATUSES.includes(order.status) && (order.source === 'caixa'
                ? ' Devolva o valor ao cliente no balcão.'
                : ' O valor é estornado automaticamente pelo Mercado Pago e o cliente recebe um e-mail; se o estorno falhar, nada é cancelado.')}
            </p>
            <label class="block">
              <span class="label">Motivo <span class="text-red-600">*</span></span>
              <select id="cancel-motivo" name="motivo" class="field" required>
                <option value="" disabled selected>Selecione o motivo</option>
                {CANCEL_REASONS.map((r) => <option value={r}>{r}</option>)}
              </select>
            </label>
            <label id="cancel-detalhe-wrap" class="block hidden">
              <span class="label">Detalhes <span class="text-red-600">*</span></span>
              <textarea id="cancel-detalhe" name="detalhe" rows="3" maxlength="400" class="field" disabled></textarea>
            </label>
            {stockOut && (
              <label class="flex items-start gap-2 text-[13px] text-ink-soft">
                <input type="checkbox" name="restock" class="mt-0.5" checked />
                Devolver os itens ao estoque (desmarque se o produto está danificado e não volta à venda)
              </label>
            )}
            {!isCaixa && (
              <label class="flex items-center gap-2 text-[13px] text-ink-soft">
                <input type="checkbox" name="notify" data-remember-notify />
                Enviar e-mail ao cliente
              </label>
            )}
            <div class="flex justify-end gap-2">
              <button type="button" id="cancel-close" class="rounded-card border border-ink/20 px-4 py-2 font-sans text-sm hover:bg-bone-200">Voltar</button>
              <button class="rounded-card bg-red-700 px-4 py-2 font-sans text-sm text-white hover:bg-red-800">Cancelar compra</button>
            </div>
          </form>
        </dialog>
      )}
      <p class="font-sans text-[12px] text-ink-muted">
        Criado em {new Date(order.created_at).toLocaleString('pt-BR')}
      </p>
    </section>
  </div>
</AdminLayout>

<script>
  import { enableConfirmForms } from '../../../lib/confirm-forms';
  import { confirmDialog } from '../../../lib/confirm-dialog';
  enableConfirmForms();

  // cancelar: motivo obrigatório ("Outro" exige o texto)
  const dlg = document.getElementById('cancel-dialog') as HTMLDialogElement | null;
  const motivo = document.getElementById('cancel-motivo') as HTMLSelectElement | null;
  const detalhe = document.getElementById('cancel-detalhe') as HTMLTextAreaElement | null;
  document.getElementById('cancel-open')?.addEventListener('click', () => dlg?.showModal());
  document.getElementById('cancel-close')?.addEventListener('click', () => dlg?.close());
  // Detalhes só aparece (e é obrigatório) em "Outro"
  motivo?.addEventListener('change', () => {
    const other = motivo.value === 'Outro';
    document.getElementById('cancel-detalhe-wrap')?.classList.toggle('hidden', !other);
    if (detalhe) {
      detalhe.required = other;
      detalhe.disabled = !other;
    }
  });

  // "Enviar e-mail ao cliente": lembra a escolha (localStorage) até mudar de novo
  const NOTIFY_KEY = 'compras-enviar-email';
  let savedNotify = false;
  try {
    savedNotify = localStorage.getItem(NOTIFY_KEY) === '1';
  } catch {}
  document.querySelectorAll<HTMLInputElement>('[data-remember-notify]').forEach((box) => {
    box.checked = savedNotify;
    box.addEventListener('change', () => {
      try {
        localStorage.setItem(NOTIFY_KEY, box.checked ? '1' : '0');
      } catch {}
    });
  });

  // copiar o código de rastreio
  document.querySelectorAll<HTMLButtonElement>('[data-copy-field]').forEach((b) =>
    b.addEventListener('click', async () => {
      const input = b.parentElement!.querySelector('input')!;
      const ok = b.closest('label, div')!.querySelector<HTMLElement>('[data-copy-ok]');
      try {
        await navigator.clipboard.writeText(input.value);
        if (ok) ok.textContent = 'Copiado!';
      } catch {
        if (ok) ok.textContent = 'Não deu para copiar';
      }
      ok?.classList.remove('hidden');
      setTimeout(() => ok?.classList.add('hidden'), 2000);
    }),
  );

  // ---- status: rastreio só em Enviado, e-mail marcado só em mudança relevante ----
  const statusForm = document.getElementById('status-form') as HTMLFormElement | null;
  const statusSel = document.querySelector<HTMLSelectElement>('[data-status-select]');
  const tracking = document.getElementById('tracking_code') as HTMLInputElement | null;
  const trackingError = document.getElementById('tracking-error');
  const notify = document.getElementById('notify') as HTMLInputElement | null;
  const current = statusForm?.dataset.current ?? '';
  const customerEmail = statusForm?.dataset.email ?? '';
  // mesmo formato do servidor (isValidTracking em lib/types)
  const validTracking = (v: string) => {
    const t = v.trim();
    if (/^[A-Z]{2}\d{9}[A-Z]{2}$/.test(t.toUpperCase())) return true;
    try {
      const u = new URL(t);
      return /^https?:$/.test(u.protocol) && /\.[a-z]{2,}$/i.test(u.hostname);
    } catch {
      return false;
    }
  };
  statusSel?.addEventListener('change', () => {
    const on = ['shipped', 'delivered'].includes(statusSel.value);
    document.getElementById('tracking-wrap')?.classList.toggle('hidden', !on);
    if (tracking) {
      tracking.required = on;
      tracking.disabled = !on;
    }
  });
  tracking?.addEventListener('input', () => {
    tracking.setCustomValidity('');
    trackingError?.classList.add('hidden');
  });
  statusForm?.addEventListener('submit', async (e) => {
    if (statusForm.dataset.confirmed) return;
    e.preventDefault();
    if (tracking && !tracking.disabled && !validTracking(tracking.value)) {
      trackingError?.classList.remove('hidden');
      tracking.focus();
      return;
    }
    // aviso marcado + e-mail inválido: não salva (desmarcado salva sem avisar)
    if (notify?.checked && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(customerEmail)) {
      await confirmDialog({
        title: 'E-mail do cliente inválido',
        message: 'Não dá para enviar o aviso. Desmarque "Enviar e-mail ao cliente" para salvar sem avisar.',
        confirmLabel: 'Entendi',
        cancelLabel: 'Fechar',
        tone: 'primary',
      });
      return;
    }
    // Pago é do Mercado Pago (webhook): marcar à mão pede confirmação
    if (statusSel?.value === 'paid' && current !== 'paid') {
      const ok = await confirmDialog({
        title: 'Aprovar pagamento manualmente?',
        message: 'Confirma a aprovação manual deste pagamento sem a validação do gateway?',
        confirmLabel: 'Confirmar',
        cancelLabel: 'Voltar',
        tone: 'primary',
      });
      if (!ok) return;
    }
    statusForm.dataset.confirmed = '1';
    statusForm.requestSubmit();
  });

  // "Copiar endereço": linha pronta para etiqueta dos Correios/transportadora
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.textContent = 'Copiado ✓';
      } catch {
        b.textContent = 'Não deu para copiar';
      }
      setTimeout(() => (b.textContent = 'Copiar endereço'), 2000);
    }),
  );
</script>
