---
import PasswordInput from '../components/PasswordInput.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { safeNextPath } from '../lib/auth';

export const prerender = false;

if (Astro.locals.user) {
  return Astro.redirect(safeNextPath(Astro.url.searchParams.get('next'), '/conta'));
}

const params = Astro.url.searchParams;
const next = safeNextPath(params.get('next'), '/conta');
const nextQs = `next=${encodeURIComponent(next)}`;
const erro = params.get('erro');
const enviado = params.get('enviado') === '1';
const prefillEmail = params.get('email') ?? '';
---

<BaseLayout title="Criar conta" description="Crie sua conta para acompanhar pedidos e salvar seus dados." noindex>
  <section class="container-x flex justify-center py-16 md:py-24">
    <div class="w-full max-w-sm">
      <p class="eyebrow">Minha conta</p>
      <h1 class="mt-3 font-display text-3xl">Criar conta</h1>

      {enviado ? (
        <div class="mt-6 rounded-card border border-agua/40 bg-agua-wash px-4 py-4 text-sm text-ink-soft">
          <p class="font-medium text-agua-dark">Confirme seu e-mail</p>
          <p class="mt-1">
            Enviamos um link de confirmação. Clique nele para ativar sua conta e entrar.
          </p>
        </div>
      ) : (
        <>
          {erro && (
            <p class="mt-5 rounded-card border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">
              {erro === 'validacao'
                ? 'Verifique os campos — a senha precisa de ao menos 8 caracteres.'
                : 'Não foi possível criar a conta. O e-mail pode já estar cadastrado.'}
            </p>
          )}

          <a href={`/api/auth/google?${nextQs}`} class="btn-outline mt-6 w-full">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.35 11.1H12v3.83h5.35c-.23 1.4-1.62 4.1-5.35 4.1-3.22 0-5.85-2.66-5.85-5.94S8.78 7.15 12 7.15c1.83 0 3.06.78 3.76 1.45l2.57-2.48C16.7 4.6 14.6 3.7 12 3.7 6.9 3.7 2.8 7.8 2.8 12.9S6.9 22.1 12 22.1c5.9 0 9.8-4.15 9.8-9.99 0-.67-.07-1.18-.16-1.7Z"/></svg>
            Continuar com Google
          </a>

          <div class="my-5 flex items-center gap-3 text-[12px] uppercase tracking-[0.12em] text-ink-muted">
            <span class="h-px flex-1 bg-ink/10"></span>ou<span class="h-px flex-1 bg-ink/10"></span>
          </div>

          <form id="signup-form" method="POST" action="/api/auth/signup" class="space-y-4">
            <input type="hidden" name="next" value={next} />
            <div>
              <label class="label" for="name">Nome completo</label>
              <input id="name" name="name" class="field" required autocomplete="name" />
            </div>
            <div>
              <label class="label" for="email">E-mail</label>
              <input id="email" name="email" type="email" class="field" required autocomplete="email" value={prefillEmail} />
              <p id="email-notice" class="mt-1 hidden text-[12px] text-red-700">! E-mail inválido. Confira o endereço.</p>
            </div>
            <div>
              <label class="label" for="email-confirm">Confirmar e-mail</label>
              <input id="email-confirm" type="email" class="field" required autocomplete="off" />
              <p id="email-confirm-notice" class="mt-1 hidden text-[12px] text-red-700">! Os e-mails não conferem.</p>
            </div>
            <div>
              <label class="label" for="password">Senha</label>
              <PasswordInput id="password" name="password" required minlength="8" autocomplete="new-password" />
              <p class="mt-1 text-[12px] text-ink-muted">Mínimo de 8 caracteres.</p>
            </div>
            <button type="submit" id="signup-btn" class="btn-primary w-full disabled:opacity-50">Criar conta</button>
          </form>
        </>
      )}

      <p class="mt-6 text-center font-sans text-[13px] text-ink-muted">
        Já tem conta?
        <a href={`/entrar?${nextQs}`} class="link-underline text-ink">Entrar</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // e-mail validado ao sair do campo + digitado duas vezes igual
  import { enableEmailConfirm } from '../lib/form-helpers';
  const email = document.getElementById('email') as HTMLInputElement | null;
  if (email) {
    enableEmailConfirm({
      email,
      confirm: document.getElementById('email-confirm') as HTMLInputElement,
      emailNotice: document.getElementById('email-notice')!,
      confirmNotice: document.getElementById('email-confirm-notice')!,
      submit: document.getElementById('signup-btn') as HTMLButtonElement,
    });
  }
</script>
