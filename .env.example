# =============================================================================
# Visionário — variáveis de ambiente
# Copie para `.env` e preencha. O site FUNCIONA sem nenhuma dessas chaves
# (modo fallback local); preencha-as para ativar Supabase, Mercado Pago e Resend.
# Veja SETUP.md para o passo a passo.
# =============================================================================

# URL pública do site (usada em SEO, sitemap, e-mails, retorno do checkout)
PUBLIC_SITE_URL=http://localhost:4321

# ----- Supabase -------------------------------------------------------------
# Sem estas: catálogo lido de src/data/catalog.json e pedidos gravados em .data/
# O Caixa (/admin/caixa) EXIGE Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Mercado Pago (Checkout Bricks) -------------------------------------
# Sem estas: o checkout usa "pagamento simulado" (aprova na hora, roda o pipeline)
# Use as credenciais de TESTE do painel de desenvolvedores.
PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Assinatura do webhook (Painel > Webhooks > "Assinatura secreta")
MP_WEBHOOK_SECRET=

# ----- Resend (e-mail transacional) --------------------------------------
# Sem estas: o e-mail de confirmação é gravado em .data/emails/<pedido>.html
RESEND_API_KEY=
RESEND_FROM="Visionário <pedidos@seudominio.com.br>"

# ----- Admin (/admin) ----------------------------------------------------
# Sem senha própria: o /admin usa a mesma conta de cliente (Supabase Auth) +
# uma linha na tabela admin_users, promovida manualmente no SQL editor (ver
# supabase/migrations/0012_admin_users.sql). Sem Supabase, /admin fica fechado.

# ----- Busca de produto por código de barras (cadastro) -----------------
# Opcional. Token da API Cosmos (Bluesoft): base brasileira de GTIN. Sem ele,
# a busca usa só as bases gratuitas Open Food/Beauty/Products Facts.
COSMOS_TOKEN=

# ----- Marca ---------------------------------------------------------------
# Nome usado em títulos, e-mails, fatura do cartão e dados estruturados.
PUBLIC_BRAND_NAME=Visionário
# Razão social + CNPJ para as páginas legais e a descrição da cobrança.
PUBLIC_BRAND_LEGAL_NAME=Visionário Acessórios LTDA
PUBLIC_BRAND_CNPJ=00.000.000/0001-00

# ----- Loja ------------------------------------------------------------------
# Número do WhatsApp em formato internacional só com dígitos (ex: 5511999999999)
PUBLIC_WHATSAPP_NUMBER=5511999999999
# Frete grátis acima deste valor (em centavos). Padrão: R$ 199,00
PUBLIC_SHIPPING_FREE_THRESHOLD_CENTS=19900
