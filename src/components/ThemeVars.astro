---
/**
 * Emite as variáveis CSS da cor de acento (--agua-*) no <head>. Precisa estar
 * em TODO documento HTML independente — não só em BaseLayout, porque
 * AdminLayout também tem <html> próprio e também usa classes
 * `agua-*` (sem isso, ficam sem cor).
 */
import { theme } from '../lib/theme';
import { hexToRgbTriplet } from '../lib/color';

const a = theme.colors.agua;
const b = theme.colors.bone as Record<string, string>;
const i = theme.colors.ink as Record<string, string>;
const t = hexToRgbTriplet;
// fundo/texto em variável para o modo escuro (html.tema-escuro troca os valores);
// .fixo-claro devolve os valores claros a blocos que já são escuros (rodapé, faixa roxa)
const vars = `--agua-default:${t(a.DEFAULT)};--agua-light:${t(a.light)};--agua-dark:${t(a.dark)};--agua-wash:${t(a.wash)};--bone:${t(b.DEFAULT)};--bone-50:${t(b['50'])};--bone-100:${t(b['100'])};--bone-200:${t(b['200'])};--bone-300:${t(b['300'])};--ink:${t(i.DEFAULT)};--ink-soft:${t(i.soft)};--ink-muted:${t(i.muted)}`;
const css = `:root{${vars}}html.tema-escuro .fixo-claro{${vars}}`;
---

<style is:global set:html={css} />
<!-- modo escuro: aplica antes de pintar (escolha guardada; sem escolha, segue o aparelho) -->
<script is:inline>
  try {
    var t = localStorage.getItem('tema') || localStorage.getItem('admin-tema');
    if (t === 'escuro' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('tema-escuro');
  } catch (e) {}
</script>
