---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PasswordInput from '../../../../components/PasswordInput.astro';
import { can } from '../../../../lib/rbac';
import { isOnline, listTeam } from '../../../../lib/repo/team';
import { listRoles } from '../../../../lib/repo/roles';
import { getOwnerEmail, isProprietor } from '../../../../lib/repo/owner';
import { takeFlash } from '../../../../lib/flash';

export const prerender = false;

const access = Astro.locals.admin!;
if (!can(access, 'equipe.ver')) return Astro.redirect('/admin/usuarios');
const id = Astro.params.id ?? '';
const isNew = id === 'novo';
// criar: Administradores ou quem tem "Criar/editar usuários" (o servidor confere de novo)
const canManageUsers = can(access, 'equipe.gerenciar');
if (isNew && !canManageUsers) return Astro.redirect('/admin/usuarios?aba=equipe');
// sem ser Administrador: só dados básicos (nome; e-mail ao criar) — senha, cargo, ativo e exclusão não
const basic = !access.isOwner;

const [team, roles, ownerEmail, proprietor] = await Promise.all([
  isNew ? Promise.resolve([]) : listTeam(),
  listRoles().catch(() => []),
  getOwnerEmail(),
  isProprietor(Astro.locals.user?.email),
]);
const member = isNew ? null : team.find((m) => m.id === id);
if (!isNew && !member) return Astro.redirect('/admin/usuarios?aba=equipe');

const me = Astro.locals.user!.id;
const isMe = member?.id === me;
// a própria conta se edita em Meu perfil (mesma tela, com os campos que dá para mudar)
if (isMe) return Astro.redirect('/admin/perfil?de=usuarios');
const isOwnerAccount = !!member && !!ownerEmail && member.email.toLowerCase() === ownerEmail;
// só o Proprietário dá/tira o cargo Administrador (o servidor confere o resto)
const assignable = roles.filter((r) => proprietor || !r.is_owner);
const options = member?.is_owner && !proprietor ? roles.filter((r) => r.is_owner) : assignable;
// outro Administrador: só o Proprietário edita; o Proprietário ninguém edita (ele usa Meu perfil)
const canManage = basic
  ? canManageUsers && !member?.is_owner
  : !isOwnerAccount && (!member?.is_owner || proprietor);
const readOnly = !canManage || isMe;
const deleteBlock = isMe
  ? 'Você não pode excluir a sua própria conta.'
  : basic
    ? 'Só Administradores excluem usuários.'
    : isOwnerAccount
    ? 'Esta conta é o Proprietário. Troque o Proprietário em Cargos › Administrador antes de excluir.'
    : '';
const flash = takeFlash(Astro.cookies);
// nome completo guardado junto: a primeira palavra é o Nome, o resto o Sobrenome
const [firstName = '', ...rest] = (member?.name ?? '').trim().split(/\s+/);
const lastName = rest.join(' ');
// Proprietário: só aparece com o cargo Administrador; só o Proprietário atual liga em outra pessoa
const adminRoleId = roles.find((r) => r.is_owner)?.id ?? '';
const canTransfer = proprietor && !readOnly && !isOwnerAccount;
// para onde vai o código (e-mail do Proprietário atual), meio escondido: ad***@dominio
const ownerMasked = ownerEmail ? ownerEmail.replace(/^(.{2}).*(@.*)$/, '$1***$2') : 'o seu e-mail';
---

<AdminLayout title={isNew ? 'Novo usuário' : 'Usuário'}>
  <a href="/admin/usuarios?aba=equipe" class="font-sans text-[12px] uppercase tracking-[0.12em] text-ink-muted hover:text-ink">← Usuários</a>

  {flash && (
    <p role="status" class:list={['mt-4 max-w-2xl rounded-card border px-3 py-2 text-sm', flash.type === 'ok' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-300 bg-red-50 text-red-800']}>{flash.text}</p>
  )}
  <div id="top-notice" role="alert" class="notice-in mt-4 hidden max-w-2xl rounded-[14px] border border-red-200 bg-red-50 px-3 py-2 font-sans text-[13px] text-red-700"></div>

  {isMe && (
    <p class="mt-4 max-w-2xl rounded-card border border-ink/10 bg-bone-50 px-3 py-2 text-sm text-ink-soft">
      Esta é a sua conta. Os seus dados ficam em <a href="/admin/perfil" class="underline">Meu perfil</a>; o seu cargo só outra pessoa altera.
    </p>
  )}
  {!canManage && !isOwnerAccount && (
    <p class="mt-4 max-w-2xl rounded-card border border-ink/10 bg-bone-50 px-3 py-2 text-sm text-ink-soft">Somente leitura: {member?.is_owner && access.isOwner
        ? 'só o Proprietário altera outros Administradores.'
        : basic
          ? 'só o Proprietário altera Administradores.'
          : 'seu cargo não permite alterar usuários da equipe.'}</p>
  )}

  <form id="member-form" method="POST" action="/api/admin/users" class="mt-4 max-w-2xl space-y-5">
    <input type="hidden" name="acao" value={isNew ? 'criar' : 'editar'} />
    <input type="hidden" name="id" value={member?.id ?? ''} />
    <fieldset disabled={readOnly} class="space-y-5">
      {/* último acesso, pequeno, em cima do nome */}
      {member && (
        <p class="-mb-3 font-sans text-[11px] text-ink-muted">
          {isOnline(member)
            ? <span class="text-green-700">● Online</span>
            : `Último login: ${member.last_sign_in_at ? new Date(member.last_sign_in_at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) : 'nunca entrou'}`}
        </p>
      )}
      {/* ordem: Nome · Sobrenome · Cargo · E-mail · Senha */}
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="label">Nome</span>
          {/* uma palavra só (o resto vai em Sobrenome) */}
          <input class="field" name="nome" value={firstName} required pattern="[^ ]+" title="Uma palavra só; o resto vai em Sobrenome" autocomplete="off" />
        </label>
        <label class="block"><span class="label">Sobrenome <span class="text-[11px] font-normal text-ink-muted/60">(opcional)</span></span><input class="field" name="sobrenome" value={lastName} autocomplete="off" /></label>
        {basic ? (
          <label class="block">
            <span class="label">Cargo</span>
            <input class="field bg-bone-50" value={isNew ? 'Um Administrador define' : member?.role_name ?? 'Sem cargo'} readonly />
          </label>
        ) : (
          <label class="block">
            <span class="label">Cargo</span>
            {/* cargo: na criação quem cria escolhe; depois, só o Proprietário muda */}
            <select class="field" name="role_id" required disabled={!isNew && !proprietor} title={!isNew && !proprietor ? 'Só o Administrador Proprietário altera o cargo de outros usuários' : undefined}>
              {!member?.role_id && <option value="" disabled selected>Escolha o cargo</option>}
              {options.map((r) => <option value={r.id} selected={r.id === member?.role_id}>{r.name}</option>)}
            </select>
          </label>
        )}
        {/* e-mail: validado ao sair do campo; quem não é Administrador só define ao criar */}
        <div>
          <label class="block">
            <span class="label">E-mail</span>
            <input id="email" class="field" type="email" name="email" value={member?.email ?? ''} required autocomplete="off" readonly={basic && !isNew} />
          </label>
          <p id="email-notice" class="mt-1 hidden text-[12px] text-red-700">! E-mail inválido. Confira o endereço.</p>
        </div>
        {/* senha: ao criar, quem escolhe o cargo define; depois, só o Proprietário redefine */}
        {!basic && (isNew || proprietor) ? (
          <div>
            {/* senha: mesma largura do Cargo, logo abaixo dele */}
            <label class="block">
              <span class="label">{isNew ? 'Senha temporária' : <>Redefinir senha temporária <span class="text-[11px] font-normal text-ink-muted/60">(opcional)</span></>}</span>
              <PasswordInput name="password" minlength="8" required={isNew} autocomplete="new-password" />
            </label>
            <p class="mt-1 text-[12px] text-ink-muted">
              {isNew
                ? 'Defina uma senha temporária (o usuário irá redefini-la em seu primeiro login).'
                : <>Por segurança, as senhas não são exibidas.<br />Ao definir uma nova senha para este usuário, ela será temporária e ele deverá criar uma nova senha no próximo acesso.</>}
            </p>
            {/* trocar a senha de alguém: aviso por e-mail só se marcar; aparece ao digitar a senha */}
            {!isNew && (
              <label id="notify-wrap" class="mt-2 hidden items-start gap-2 text-[13px] text-ink-soft">
                <input type="checkbox" name="avisar_senha" class="mt-0.5" />
                <span>Enviar email de aviso de alteração informando a nova senha para o usuário? — Isso vai permitir que ele tenha acesso à nova senha e redefiní-la</span>
              </label>
            )}
          </div>
        ) : <div class="hidden sm:block" />}
        {/* confirmar e-mail: só aparece/é exigido quando o e-mail é novo ou mudou */}
        <div id="email-confirm-wrap" class:list={[!isNew && 'hidden']}>
          <label class="block">
            <span class="label">Confirmar e-mail</span>
            <input id="email-confirm" class="field" type="email" autocomplete="off" />
          </label>
          <p id="email-confirm-notice" class="mt-1 hidden text-[12px] text-red-700">! Os e-mails não conferem.</p>
        </div>
      </div>
      {isNew && (
        <p class="text-[12px] text-ink-muted">
          {basic
            ? 'A conta é criada sem cargo; a pessoa recebe um e-mail para criar a própria senha. Use um e-mail que ainda não tenha cadastro na loja.'
            : 'Use um e-mail que ainda não tenha cadastro na loja. A pessoa recebe um e-mail de boas-vindas com a senha temporária.'}
        </p>
      )}
      {!basic && (
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="is_active" checked={member?.is_active ?? true} />
          Ativo (entra no painel com o acesso do cargo)
        </label>
      )}
    </fieldset>

    {/* Proprietário: só o Proprietário atual vê (e só nos Administradores); fora do fieldset */}
    {proprietor && (
    <div id="owner-field" class:list={['rounded-card border border-ink/10 bg-white px-4 py-3', member?.role_id !== adminRoleId && 'hidden']}>
        <label class:list={['flex items-center justify-between gap-4', canTransfer ? 'cursor-pointer' : 'cursor-not-allowed opacity-60']}>
          <span>
            <span class="block text-sm font-medium">Proprietário</span>
            <span class="block text-[12px] text-ink-muted">
              {isOwnerAccount
                ? 'Esta pessoa é o Proprietário (responsável legal da conta).'
                : canTransfer
                  ? 'Responsável legal da conta.'
                  : 'Só o Proprietário atual pode passar a posse da conta.'}
            </span>
          </span>
          <input type="checkbox" name="proprietario" checked={isOwnerAccount} disabled={!canTransfer} class="peer sr-only" />
          <span class="relative h-6 w-11 shrink-0 rounded-full bg-ink/20 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:bg-agua-dark peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-agua" aria-hidden="true"></span>
        </label>
      </div>
    )}

    {/* fixo enquanto o toggle Proprietário estiver ligado (some ao desligar) */}
    <p id="owner-notice" role="alert" class="notice-in hidden rounded-[14px] border border-amber-300 bg-amber-50 px-3 py-2 font-sans text-[13px] text-amber-800">
      ! Ao salvar você deixará de ser o proprietário do sistema; para desfazer essa ação será preciso solicitar para <strong>{member?.name || member?.email}</strong>.
    </p>
    <p id="delete-notice" role="alert" class="notice-in hidden rounded-[14px] border border-red-200 bg-red-50 px-3 py-2 font-sans text-[13px] text-red-700">! {deleteBlock}</p>
    {!readOnly ? (
      <div class="grid grid-cols-3 gap-3 pt-2">
        <button type="submit" id="save-btn" class="btn-primary w-full">{isNew ? 'Criar usuário' : 'Salvar'}</button>
        <button type="button" id="cancel-btn" class="btn-outline w-full">Cancelar</button>
        <button type="button" id="delete-btn" class:list={['btn-outline w-full', deleteBlock && 'cursor-not-allowed opacity-40']} aria-disabled={deleteBlock ? 'true' : undefined}>Excluir</button>
      </div>
    ) : (
      <a href="/admin/usuarios?aba=equipe" class="btn-outline inline-block">Voltar</a>
    )}
  </form>

  {/* código da troca do Proprietário (enviado ao e-mail do Proprietário atual) */}
  <dialog id="token-dialog" class="m-auto w-[min(92vw,26rem)] rounded-card border border-ink/10 bg-bone p-0 text-ink shadow-xl backdrop:bg-ink/50">
    <form id="token-form" class="p-6">
      <h2 class="font-display text-xl">Confirme a troca do Proprietário</h2>
      <p class="mt-2 font-sans text-sm text-ink-soft">Enviamos um código de 6 dígitos para <strong>{ownerMasked}</strong>. Digite-o para concluir; ele vale por 15 minutos. Não chegou? Olhe o spam ou reenvie.</p>
      <input id="token-code" class="field mt-4 text-center text-xl tracking-[0.4em]" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required aria-label="Código de 6 dígitos" />
      <p id="token-error" class="mt-2 hidden font-sans text-[13px] text-red-700"></p>
      <div class="mt-6 flex justify-end gap-2">
        <button type="button" id="token-resend" class="mr-auto font-sans text-[13px] text-ink-muted underline">Reenviar código</button>
        <button type="button" id="token-cancel" class="rounded-card border border-ink/20 px-4 py-2 font-sans text-sm hover:bg-bone-200">Cancelar</button>
        <button type="submit" class="rounded-card bg-ink px-4 py-2 font-sans text-sm text-bone hover:bg-ink-soft">Concluir</button>
      </div>
    </form>
  </dialog>

  {member && !readOnly && (
    <form id="delete-form" method="POST" action="/api/admin/users" class="hidden">
      <input type="hidden" name="acao" value="excluir" />
      <input type="hidden" name="id" value={member.id} />
    </form>
  )}
</AdminLayout>

<script define:vars={{ deleteBlock, isNew, label: member?.name || member?.email || '', adminRoleId }}>
  window.__member = { deleteBlock, isNew, label, adminRoleId };
</script>

<script>
  import { askSaveActive, confirmDialog } from '../../../../lib/confirm-dialog';
  import { enableEmailConfirm, enableSingleWord } from '../../../../lib/form-helpers';

  const { deleteBlock, isNew, label, adminRoleId } = (window as any).__member as {
    deleteBlock: string;
    isNew: boolean;
    label: string;
    adminRoleId: string;
  };
  const form = document.getElementById('member-form') as HTMLFormElement;
  const top = document.getElementById('top-notice')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement | null;
  enableSingleWord(form.querySelector('input[name=nome]'));

  // senha de outra pessoa: limpa antes de sair da tela, senão o navegador oferece
  // guardá-la como se fosse um login seu (pop-up "qual conta atualizar")
  const clearPassword = () => {
    if (passInput) passInput.value = '';
  };

  // aviso por e-mail da nova senha: só aparece com algo digitado em Redefinir senha
  const passInput = form.querySelector('input[name=password]') as HTMLInputElement | null;
  const notifyWrap = document.getElementById('notify-wrap');
  passInput?.addEventListener('input', () => {
    const show = !!passInput.value;
    notifyWrap?.classList.toggle('hidden', !show);
    notifyWrap?.classList.toggle('flex', show);
    // apagou a senha: desmarca (não avisa sem senha nova)
    const box = notifyWrap?.querySelector('input') as HTMLInputElement | null;
    if (!show && box) box.checked = false;
  });

  // e-mail validado ao sair do campo + confirmação igual (Salvar desabilitado se errado)
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const checkEmail = saveBtn
    ? enableEmailConfirm({
        email: emailInput,
        confirm: document.getElementById('email-confirm') as HTMLInputElement,
        emailNotice: document.getElementById('email-notice')!,
        confirmNotice: document.getElementById('email-confirm-notice')!,
        confirmWrap: document.getElementById('email-confirm-wrap'),
        submit: saveBtn,
        initial: isNew ? '' : emailInput.defaultValue,
      })
    : () => true;

  function showTop(text: string) {
    top.textContent = `! ${text}`;
    top.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Proprietário só aparece com o cargo Administrador escolhido
  // e o toggle só liga se o Cargo escolhido for Administrador
  const roleSelect = form.querySelector('select[name=role_id]') as HTMLSelectElement | null; // não existe no modo básico
  const ownerField = document.getElementById('owner-field'); // só existe para o Proprietário
  const ownerToggle = form.querySelector('input[name=proprietario]') as HTMLInputElement | null;
  const ownerLocked = !!ownerToggle?.disabled; // travado pelo servidor (sem permissão ou já é o Proprietário)
  const syncOwnerField = () => {
    const isAdmin = !!adminRoleId && roleSelect?.value === adminRoleId;
    ownerField?.classList.toggle('hidden', !isAdmin);
    if (ownerToggle && !ownerLocked) {
      ownerToggle.disabled = !isAdmin;
      if (!isAdmin) ownerToggle.checked = false;
    }
  };
  roleSelect?.addEventListener('change', syncOwnerField);
  syncOwnerField();

  // ---- ligar "Proprietário": confirma, mas só envia ao salvar ----
  const ownerNotice = document.getElementById('owner-notice')!;
  const transferring = () => !!ownerToggle && !ownerToggle.disabled && ownerToggle.checked && !ownerToggle.defaultChecked;
  const syncOwnerNotice = () => ownerNotice.classList.toggle('hidden', !transferring());
  ownerToggle?.addEventListener('change', async () => {
    if (ownerToggle.checked) {
      const go = await confirmDialog({
        title: 'Atenção: Você deixará de ser o proprietário do sistema.',
        message: 'Ao salvar, um código de segurança será enviado ao seu e-mail. Após a confirmação, você não poderá desfazer esta alteração. Deseja continuar?',
        confirmLabel: 'Continuar',
        cancelLabel: 'Cancelar',
        tone: 'primary',
      });
      if (!go) ownerToggle.checked = false;
    }
    syncOwnerNotice();
  });
  roleSelect?.addEventListener('change', syncOwnerNotice);

  // ---- código da troca do Proprietário ----
  const dialog = document.getElementById('token-dialog') as HTMLDialogElement;
  const codeInput = document.getElementById('token-code') as HTMLInputElement;
  const tokenError = document.getElementById('token-error')!;
  /** pede o código ao e-mail do Proprietário atual (vai junto o cargo escolhido) */
  async function requestOwnerCode() {
    const body = new FormData();
    body.set('acao', 'pedir_codigo_proprietario');
    body.set('id', (form.querySelector('input[name=id]') as HTMLInputElement).value);
    if (roleSelect) body.set('role_id', roleSelect.value);
    const res = await fetch(form.action, { method: 'POST', body, headers: { accept: 'application/json' } });
    return (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
  }
  document.getElementById('token-resend')!.addEventListener('click', async () => {
    tokenError.classList.remove('hidden');
    tokenError.textContent = 'Enviando…';
    const r = await requestOwnerCode().catch(() => ({ ok: false, error: 'Sem conexão com o servidor.' }));
    tokenError.textContent = r.ok ? 'Código reenviado. Use o mais recente.' : r.error || 'Não foi possível reenviar.';
  });

  // nada foi salvo ainda: o código confirma e aí o salvar vai junto
  function openToken() {
    codeInput.value = '';
    tokenError.classList.add('hidden');
    dialog.showModal();
    codeInput.focus();
  }
  document.getElementById('token-cancel')!.addEventListener('click', () => dialog.close()); // nada foi salvo
  document.getElementById('token-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = new FormData(form);
    body.set('codigo_proprietario', codeInput.value);
    try {
      const res = await fetch(form.action, { method: 'POST', body, headers: { accept: 'application/json' } });
      const r = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (r.ok) {
        clearPassword();
        return void window.location.reload();
      }
      tokenError.textContent = r.error || 'Código incorreto.';
    } catch {
      tokenError.textContent = 'Sem conexão com o servidor.';
    }
    tokenError.classList.remove('hidden');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!saveBtn || !form.reportValidity()) return;
    // Ativo só existe para Administradores (quem edita só dados básicos não vê)
    const activeEl = form.querySelector('input[name=is_active]') as HTMLInputElement | null;
    if (activeEl) {
      const ok = await askSaveActive(activeEl.checked, {
        on: 'A pessoa entra no painel com o acesso do cargo.',
        off: 'A pessoa continua na equipe, mas fica sem acesso a nenhuma tela.',
      });
      if (!ok) return;
    }
    saveBtn.disabled = true;
    top.classList.add('hidden');
    try {
      // passando a posse: primeiro o código (ao seu e-mail); o salvar vai depois, junto com ele
      if (transferring()) {
        const r = await requestOwnerCode();
        if (r.ok) return openToken();
        return showTop(r.error || 'Não foi possível enviar o código.');
      }
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
      const r = (await res.json().catch(() => ({}))) as { ok?: boolean; id?: string; error?: string };
      if (r.ok && r.id) {
        clearPassword();
        return void (window.location.href = `/admin/usuarios/equipe/${r.id}`);
      }
      showTop(r.error || 'Não foi possível salvar.');
    } catch {
      showTop('Sem conexão com o servidor.');
    } finally {
      saveBtn.disabled = false;
      checkEmail(); // volta a travar se o e-mail estiver errado
    }
  });

  // Cancelar volta para Usuários; só pergunta se algo foi alterado
  const snapshot = () => JSON.stringify([...new FormData(form)].map(([k, v]) => [k, String(v)]));
  const initialForm = snapshot();
  document.getElementById('cancel-btn')?.addEventListener('click', async () => {
    const dirty = snapshot() !== initialForm || !!(document.getElementById('email-confirm') as HTMLInputElement | null)?.value;
    if (dirty) {
      const leave = await confirmDialog({ title: 'Sair e perder alterações?', confirmLabel: 'Sair', cancelLabel: 'Manter alterações' });
      if (!leave) return;
    }
    window.location.href = '/admin/usuarios?aba=equipe';
  });

  document.getElementById('delete-btn')?.addEventListener('click', async () => {
    if (deleteBlock) {
      const n = document.getElementById('delete-notice')!;
      n.classList.remove('hidden', 'notice-in');
      void n.offsetWidth; // repete a animação a cada clique
      n.classList.add('notice-in');
      return;
    }
    if (isNew) {
      const discard = await confirmDialog({ title: 'Descartar este cadastro?', message: 'Nada foi salvo ainda.', confirmLabel: 'Descartar' });
      if (discard) window.location.href = '/admin/usuarios?aba=equipe';
      return;
    }
    const ok = await confirmDialog({
      title: 'Excluir usuário?',
      message: `${label} perde o acesso ao painel. Se a conta nunca comprou na loja, ela é apagada.`,
    });
    if (ok) (document.getElementById('delete-form') as HTMLFormElement).submit();
  });
</script>
