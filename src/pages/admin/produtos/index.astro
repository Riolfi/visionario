---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getProducts } from '../../../lib/repo/catalog';
import { brl } from '../../../lib/format';
import CameraScanButton, { SCAN_BTN, CHECK_ICON_PATH } from '../../../components/CameraScanButton';

export const prerender = false;

const products = await getProducts({ includeInactive: true, sort: 'novidades' });
---

<AdminLayout title="Produtos">
  <div class="flex items-center justify-between">
    <p class="font-sans text-sm text-ink-muted">{products.length} produtos no catálogo</p>
    <a href="/admin/produtos/novo" class="btn-primary">Novo produto</a>
  </div>

  <div class="mt-4 rounded-card border border-ink/10 bg-white p-4">
    <label class="label" for="barcode-scan">Código de barras</label>
    <div class="flex items-stretch gap-2">
      <input
        id="barcode-scan"
        class="field min-w-0 flex-1"
        inputmode="numeric"
        placeholder="digitar código de barras manualmente"
        autocomplete="off"
      />
      <button type="button" id="barcode-send" class={SCAN_BTN}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={CHECK_ICON_PATH} /></svg>
        Enviar
      </button>
    </div>
    <div class="mt-2 flex justify-end"><CameraScanButton client:load targetId="barcode-scan" /></div>
    <p class="mt-1.5 font-sans text-[12px] text-ink-muted">Pesquise para criar ou editar um produto</p>
    <p id="barcode-scan-status" class="mt-1 font-sans text-[13px] text-ink-muted empty:hidden" aria-live="polite"></p>
  </div>

  <!-- table-fixed + nome truncado: cabe na tela sem rolagem lateral -->
  <div class="mt-6 rounded-card border border-ink/10 bg-white">
    <table class="w-full table-fixed text-left text-sm">
      <thead class="border-b border-ink/10 text-[11px] uppercase tracking-[0.1em] text-ink-muted">
        <tr>
          <th class="px-2 py-3 sm:px-3">Produto</th>
          <th class="hidden w-20 px-3 py-3 text-right sm:table-cell">Estoque</th>
          <th class="w-[4.5rem] px-1 py-3 sm:w-24 sm:px-3">Status</th>
          <th class="w-[7.5rem] px-2 py-3 sm:w-44 sm:px-3"><span class="sr-only">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        {products.map((p) => (
          <tr class="border-t border-ink/10 hover:bg-bone-50">
            <td class="px-2 py-3 sm:px-3">
              <a href={`/admin/produtos/${p.id}`} class="block truncate font-medium text-agua-dark" title={p.name}>{p.name}</a>
              <span class="block truncate text-[12px] text-ink-muted">{brl(p.price_cents)}<span class="hidden sm:inline"> · {p.category_name}</span></span>
            </td>
            <td class:list={['hidden px-3 py-3 text-right sm:table-cell', p.stock <= 5 && 'text-red-700']}>{p.stock}</td>
            <td class="px-1 py-3 sm:px-3">
              <span class:list={['rounded-full px-2 py-0.5 text-[10px] uppercase sm:text-[11px]', p.is_active ? 'bg-agua-wash text-agua-dark' : 'bg-bone-200 text-ink-muted']}>
                {p.is_active ? 'ativo' : 'inativo'}
              </span>
            </td>
            <td class="px-2 py-3 sm:px-3">
              <div class="flex justify-end gap-1.5 sm:gap-2">
                <a href={`/admin/produtos/${p.id}`} class="rounded-card border border-ink/20 px-2 py-1 text-[12px] hover:bg-bone-100 sm:px-3 sm:text-[13px]">Editar</a>
                <button
                  type="button"
                  data-delete-id={p.id}
                  data-delete-name={p.name}
                  class="rounded-card border border-red-300 px-2 py-1 text-[12px] text-red-700 hover:bg-red-50 disabled:opacity-50 sm:px-3 sm:text-[13px]"
                >
                  Excluir
                </button>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>

<script>
  import { deleteProductFlow } from '../../../lib/delete-product';

  // Excluir direto da lista — mesma API e confirmação do botão no cadastro
  document.querySelectorAll<HTMLButtonElement>('[data-delete-id]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      const r = await deleteProductFlow(btn.dataset.deleteId!, btn.dataset.deleteName!);
      if (r === 'deleted' || r === 'deactivated') return window.location.reload();
      if (r !== 'cancelled') alert(r.error);
      btn.disabled = false;
    });
  });

  const input = document.getElementById('barcode-scan') as HTMLInputElement | null;
  const status = document.getElementById('barcode-scan-status');

  // Enter (leitor USB / teclado) e o botão "Enviar" fazem a mesma busca
  input?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    search();
  });
  document.getElementById('barcode-send')?.addEventListener('click', () => search());

  async function search() {
    if (!input) return;
    const code = input.value.trim();
    if (!code) return input.focus();

    input.disabled = true;
    if (status) status.textContent = 'Buscando…';
    try {
      const res = await fetch(`/api/admin/products/by-barcode?code=${encodeURIComponent(code)}`);
      if (res.ok) {
        const data = (await res.json()) as { id: string };
        window.location.href = `/admin/produtos/${data.id}`;
        return;
      }
      if (res.status === 404) {
        window.location.href = `/admin/produtos/novo?barcode=${encodeURIComponent(code)}`;
        return;
      }
      if (status) status.textContent = 'Erro ao buscar — tenta de novo.';
    } catch {
      if (status) status.textContent = 'Erro de conexão.';
    } finally {
      input.disabled = false;
    }
  }
</script>
