---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { caixaLedger, todaySP } from '../../../lib/repo/orders';
import { listTeam } from '../../../lib/repo/team';
import { brl, orderLabel } from '../../../lib/format';
import { PAYMENT_METHOD_LABELS } from '../../../lib/types';

export const prerender = false;

/*
 * Registro de Caixa: vendas (entradas) e cancelamentos (saídas) do Caixa num
 * período — começa em hoje. Cada pessoa vê o próprio caixa; só Administradores
 * escolhem outro usuário (ou todos). "Exportar PDF" imprime o que está filtrado.
 */
const access = Astro.locals.admin!;
const me = Astro.locals.user!.id;
const isAdmin = access.isOwner;
const params = Astro.url.searchParams;
const isDay = (v: string | null) => !!v && /^\d{4}-\d{2}-\d{2}$/.test(v);
const today = todaySP();
let from = isDay(params.get('de')) ? params.get('de')! : today;
let to = isDay(params.get('ate')) ? params.get('ate')! : from;
if (to < from) [from, to] = [to, from];
// usuário: Administrador escolhe (vazio = todos); os demais, sempre o próprio
const pick = params.get('usuario') ?? '';
const operatorId = isAdmin ? (/^[0-9a-f-]{36}$/i.test(pick) ? pick : null) : me;

const [entries, team] = await Promise.all([caixaLedger({ from, to, operatorId }), listTeam().catch(() => [])]);
const rows = entries ?? [];
const nameOf = (id: string | null) => {
  const m = team.find((t) => t.id === id);
  return m ? m.name || m.email : '—';
};
const sales = rows.filter((r) => r.kind === 'venda');
const refunds = rows.filter((r) => r.kind === 'cancelamento');
const inCents = sales.reduce((t, r) => t + r.cents, 0);
const outCents = refunds.reduce((t, r) => t - r.cents, 0);
// saldo por forma de pagamento (vendas menos cancelamentos)
const byMethod = new Map<string, number>();
for (const r of rows) {
  const k = r.payment_method ? PAYMENT_METHOD_LABELS[r.payment_method] : 'Outro';
  byMethod.set(k, (byMethod.get(k) ?? 0) + r.cents);
}
const br = (d: string) => d.split('-').reverse().join('/');
const period = from === to ? br(from) : `${br(from)} a ${br(to)}`;
const who = operatorId ? nameOf(operatorId) : 'Todos os usuários';
const fmt = (d: string) => new Date(d).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Sao_Paulo' });
---

<AdminLayout title="Registro de Caixa">
  <div class="no-print flex items-center justify-between gap-3">
    <a href="/admin/caixa" class="font-sans text-[12px] uppercase tracking-[0.12em] text-ink-muted hover:text-ink">← Caixa</a>
    <button type="button" id="export-pdf" data-file={`registro-de-caixa-${from}${from === to ? '' : `-a-${to}`}`} class="inline-flex items-center gap-2 rounded-card border border-ink/20 px-3 py-2 text-sm hover:bg-bone-100" title="Exportar PDF" aria-label="Exportar PDF">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /><path d="M12 12v6m0 0-2.5-2.5M12 18l2.5-2.5" /></svg>
      Exportar PDF
    </button>
  </div>

  {/* filtro: período (e usuário, para Administradores) */}
  <form method="GET" class="no-print mt-4 rounded-card border border-ink/10 bg-white p-4">
    <div class="grid gap-3 sm:grid-cols-[repeat(auto-fit,minmax(11rem,1fr))]">
      <label class="block"><span class="label">De</span><input type="date" name="de" value={from} max={today} class="field" /></label>
      <label class="block"><span class="label">Até</span><input type="date" name="ate" value={to} max={today} class="field" /></label>
      {isAdmin && (
        <label class="block">
          <span class="label">Usuário</span>
          <select name="usuario" class="field">
            <option value="">Todos os usuários</option>
            {team.map((m) => <option value={m.id} selected={m.id === operatorId}>{m.name || m.email}</option>)}
          </select>
        </label>
      )}
    </div>
    <div class="mt-3 flex gap-2">
      <button class="btn-primary">Filtrar</button>
      <a href="/admin/caixa/registro" class="btn-outline">Hoje</a>
    </div>
  </form>

  <div class="print-area">
    {/* cabeçalho que só aparece no PDF */}
    <div class="print-only">
      <h2 class="font-display text-xl">Registro de Caixa</h2>
      <p class="text-sm">Período: {period} · Usuário: {who} · Gerado em {fmt(new Date().toISOString())}</p>
    </div>

    <p class="no-print mt-4 font-sans text-sm text-ink-muted">{period} · {who} · {rows.length} {rows.length === 1 ? 'registro' : 'registros'}</p>

    <section class="mt-3 grid gap-3 sm:grid-cols-3" aria-label="Resumo">
      <div class="rounded-card border border-ink/10 bg-white p-4"><p class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Entradas</p><p class="font-display text-xl">{brl(inCents)}</p><p class="text-[12px] text-ink-muted">{sales.length} {sales.length === 1 ? 'venda' : 'vendas'}</p></div>
      <div class="rounded-card border border-ink/10 bg-white p-4"><p class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Saídas</p><p class="font-display text-xl text-red-700">{outCents ? `− ${brl(outCents)}` : brl(0)}</p><p class="text-[12px] text-ink-muted">{refunds.length} {refunds.length === 1 ? 'cancelamento' : 'cancelamentos'}</p></div>
      <div class="rounded-card border border-ink/10 bg-white p-4"><p class="text-[11px] uppercase tracking-[0.08em] text-ink-muted">Saldo</p><p class="font-display text-xl">{brl(inCents - outCents)}</p>
        {byMethod.size > 0 && <p class="text-[12px] text-ink-muted">{[...byMethod].map(([k, v]) => `${k}: ${brl(v)}`).join(' · ')}</p>}
      </div>
    </section>

    <div data-table class="data-table-box mt-4 rounded-card border border-ink/10 bg-white">
      <table class="w-full min-w-[50rem] text-left text-sm">
        <thead class="border-b border-ink/10 text-[11px] uppercase tracking-[0.1em] text-ink-muted">
          <tr>
            <th class="px-3 py-3" data-sort="date">Data</th>
            <th class="px-3 py-3" data-sort="text">Venda</th>
            <th class="px-3 py-3" data-sort="text">Cliente</th>
            <th class="px-3 py-3">Tipo</th>
            <th class="px-3 py-3">Usuário</th>
            <th class="px-3 py-3">Pagamento</th>
            <th class="px-3 py-3 text-right" data-sort="number">Valor</th>
            <th class="px-3 py-3">Motivo</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-t border-ink/10">
              <td class="whitespace-nowrap px-3 py-2 text-ink-muted" data-sort={r.at}>{fmt(r.at)}</td>
              <td class="whitespace-nowrap px-3 py-2" data-sort={r.order_number}><a href={`/admin/pedidos/${r.order_number}`} class="text-agua-dark underline">{orderLabel(r.order_number)}</a></td>
              <td class="whitespace-nowrap px-3 py-2">{r.customer_name}</td>
              <td class="px-3 py-2">
                <span class:list={['inline-block rounded-full px-2 py-0.5 text-[11px] font-medium uppercase', r.kind === 'venda' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800']}>{r.kind === 'venda' ? 'Venda' : 'Cancelamento'}</span>
              </td>
              <td class="whitespace-nowrap px-3 py-2">{nameOf(r.operator_id)}</td>
              <td class="whitespace-nowrap px-3 py-2 text-ink-soft">{r.payment_method ? PAYMENT_METHOD_LABELS[r.payment_method] : '—'}</td>
              <td class:list={['whitespace-nowrap px-3 py-2 text-right', r.cents < 0 && 'text-red-700']} data-sort={r.cents}>{r.cents < 0 ? `− ${brl(-r.cents)}` : brl(r.cents)}</td>
              <td class="px-3 py-2 text-ink-soft">{r.reason || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {entries === null && <p class="p-4 text-sm text-red-700">Não foi possível carregar o registro. Tente de novo.</p>}
      {entries !== null && !rows.length && <p class="p-4 text-sm text-ink-muted">Nenhuma venda ou cancelamento no período.</p>}
    </div>
  </div>
</AdminLayout>

<script>
  // PDF: a impressão do navegador ("Salvar como PDF"), com o nome do arquivo no título
  document.getElementById('export-pdf')?.addEventListener('click', (e) => {
    const old = document.title;
    document.title = (e.currentTarget as HTMLElement).dataset.file ?? 'registro-de-caixa';
    window.addEventListener('afterprint', () => (document.title = old), { once: true });
    window.print();
  });
</script>
